----------------------------------------------------------------
-- Control mode + camera
----------------------------------------------------------------
local function restoreHum()
	if savedHum and savedHum.hum and savedHum.hum.Parent then
		local h = savedHum.hum
		h.WalkSpeed = savedHum.WalkSpeed
		h.JumpPower = savedHum.JumpPower
		h.JumpHeight = savedHum.JumpHeight
	end
	savedHum = nil
end

local function freezeHum(hum)
	if savedHum and savedHum.hum == hum then return end
	restoreHum()
	savedHum = {
		hum = hum,
		WalkSpeed = hum.WalkSpeed,
		JumpPower = hum.JumpPower,
		JumpHeight = hum.JumpHeight,
	}
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.JumpHeight = 0
end

local function applyMode(hum)
	local engaged = S.state ~= "landed"
	-- walking is frozen while the rocket is yours to steer
	if engaged then freezeHum(hum) else restoreHum() end

	local want = hum
	if engaged and camPart and S.camFollow and not S.ride then want = camPart end
	if cam.CameraType ~= Enum.CameraType.Custom then cam.CameraType = Enum.CameraType.Custom end
	if lastSubject ~= want then
		cam.CameraSubject = want
		lastSubject = want
	end
end

----------------------------------------------------------------
-- Main loop
----------------------------------------------------------------
local function clampMag(v, m)
	if v.Magnitude > m then return v.Unit * m end
	return v
end

local function step(dt)
	local root, hum = getRoot(), getHum()
	if not root or not hum then return end
	local t = tick()
	local sz = S.size

	applyMode(hum)

	-- ground below the rocket
	local ignore = { lp.Character }
	local folder = getToyFolder()
	if folder then table.insert(ignore, folder) end
	if skin then table.insert(ignore, skin.model) end
	rayParams.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(V(pos.X, pos.Y + 300, pos.Z), V(0, -3000, 0), rayParams)
	local groundY = hit and hit.Position.Y or padGround
	local restY = groundY + REST_H * sz

	local shake = V(0, 0, 0)

	if S.state == "landed" then
		vel = Vector3.zero
		pos = V(padPos.X, restY, padPos.Z)
		intensity = intensity * math.max(0, 1 - dt * 6)

	elseif S.state == "countdown" then
		local c = t - cdT0
		vel = Vector3.zero
		pos = V(padPos.X, restY, padPos.Z)
		intensity = math.clamp(c / 3, 0, 1) * 0.95
		local a = 0.04 + 0.12 * math.clamp(c / 3, 0, 1)
		shake = V((math.random() - 0.5) * a, (math.random() - 0.5) * a, (math.random() - 0.5) * a) * sz
		local left = math.ceil(3 - c)
		if left >= 1 then
			setStatus("liftoff in " .. left)
		end
		if c >= 3 then
			setState("flying")
			vel = V(0, S.speed * 0.9, 0)
			climbUntil = t + 2.5
		end

	elseif S.state == "flying" then
		local md = hum.MoveDirection
		local boost = S.boostHeld and 2 or 1
		local v = (S.upHeld and 1 or 0) - (S.downHeld and 1 or 0)
		local targetVy = v * S.speed * 0.7 * boost
		if t < climbUntil then targetVy = math.max(targetVy, S.speed) end
		local target = V(md.X * S.speed * boost, targetVy, md.Z * S.speed * boost)
		vel = vel:Lerp(target, 1 - math.exp(-dt * 1.6))
		local h = V(vel.X, 0, vel.Z).Magnitude / (S.speed * 2)
		intensity = math.clamp(0.45 + 0.4 * h + (v > 0 and 0.25 or 0) + (S.boostHeld and 0.4 or 0), 0, 1.6)
		pos += vel * dt
		if pos.Y < restY then
			pos = V(pos.X, restY, pos.Z)
			vel = V(vel.X, math.max(vel.Y, 0), vel.Z)
		end

	else -- landing: slow descent straight down
		local alt = pos.Y - restY
		local descend = -math.clamp(alt * 0.6, 8, S.speed * 0.6)
		vel = vel:Lerp(V(0, descend, 0), 1 - math.exp(-dt * 2))
		intensity = 0.55
		pos += vel * dt
		if alt <= 0.6 then
			pos = V(pos.X, restY, pos.Z)
			padPos = V(pos.X, padPos.Y, pos.Z)
			padGround = groundY
			setState("landed")
		end
	end

	-- indestructible: never fall into the void
	if S.safe then
		local floor = workspace.FallenPartsDestroyHeight + 100
		if pos.Y < floor then
			pos = V(pos.X, floor, pos.Z)
			vel = V(vel.X, math.max(vel.Y, 0), vel.Z)
		end
	end

	-- lean into the direction of travel; slowly spin while the engine runs
	local hv = V(vel.X, 0, vel.Z)
	local goalTilt = clampMag(hv / (S.speed * 2), 1)
	if S.state == "landed" or S.state == "countdown" then goalTilt = V(0, 0, 0) end
	tiltVec = tiltVec:Lerp(goalTilt, 1 - math.exp(-dt * 5))
	local tilt = CFrame.new()
	if tiltVec.Magnitude > 0.01 then
		local axis = Vector3.yAxis:Cross(tiltVec.Unit)
		tilt = CFrame.fromAxisAngle(axis, tiltVec.Magnitude * math.rad(40))
	end
	if S.state == "flying" or S.state == "landing" then roll += dt * 0.5 end
	local bodyCF = CFrame.new(pos + shake) * tilt * CFrame.Angles(0, roll, 0)

	-- camera anchor
	if camPart then camPart.CFrame = CFrame.new(bodyCF.Position) end

	-- ride on the nose (optional)
	if S.ride then
		local seat = bodyCF:PointToWorldSpace(V(0, 6.0 * sz + 3, 0))
		root.CFrame = CFrame.new(seat) * root.CFrame.Rotation
		root.AssemblyLinearVelocity = Vector3.zero
		root.AssemblyAngularVelocity = Vector3.zero
	end

	-- flame flicker
	local flick = intensity * (0.82 + 0.18 * math.sin(t * 40) + 0.08 * math.random())

	-- detailed skin
	if S.skin and skin then
		skin.rocket:PivotTo(bodyCF)
		skin.nozzle.CFrame = bodyCF * CFrame.new(0, -4.5 * sz, 0)
		local L = 0.4 + 2.2 * flick
		local on = flick > 0.05
		local sideways = CFrame.Angles(0, 0, math.pi / 2)
		skin.flameOuter.Transparency = on and 0.4 or 1
		skin.flameInner.Transparency = on and 0.15 or 1
		skin.glow.Transparency = on and 0.6 or 1
		skin.flameOuter.Size = V(L * sz, 0.95 * sz, 0.95 * sz)
		skin.flameOuter.CFrame = bodyCF * CFrame.new(0, -(4.5 + L / 2) * sz, 0) * sideways
		skin.flameInner.Size = V(L * 0.75 * sz, 0.5 * sz, 0.5 * sz)
		skin.flameInner.CFrame = bodyCF * CFrame.new(0, -(4.5 + L * 0.75 / 2) * sz, 0) * sideways
		skin.glow.CFrame = bodyCF * CFrame.new(0, -4.55 * sz, 0)
		skin.fire.Rate = on and (40 + flick * 80) or 0
		-- smoke also pours out on the pad, so liftoff looks right
		local low = (pos.Y - groundY) < 25 * sz
		skin.smoke.Rate = (flick > 0.1 and low) and (20 + flick * 60) or ((flick > 0.1) and 10 or 0)
	end

	-- indestructible upkeep: one toy re-claimed every 0.1 s, refill every 1.5 s
	if S.safe then
		safeTimer += dt
		if safeTimer >= 0.1 and #claimed > 0 then
			safeTimer = 0			reclaimIdx = reclaimIdx % #claimed + 1
			local c = claimed[reclaimIdx]
			if c.part.Parent then
				if not ownsPart(c.part) then claim(c.part) end
				c.part.CanCollide = false
			end
		end
		refillTimer += dt
		if refillTimer >= 1.5 then
			refillTimer = 0
			refill()
		end
	end

	-- toys form the rocket
	local rot = bodyCF.Rotation
	for _, c in ipairs(claimed) do
		local part = c.part
		if part.Parent then
			local target = bodyCF:PointToWorldSpace(slotLocal(SL[c.si], flick) * sz)
			if S.safe then
				makeMovers(c) -- rebuild movers if something removed them
				local lv = part.AssemblyLinearVelocity
				if lv.Magnitude > S.speed * 3 + 250 then -- flung: stop it
					part.AssemblyLinearVelocity = Vector3.zero
					part.AssemblyAngularVelocity = Vector3.zero
				end
				if (part.Position - target).Magnitude > 300 then -- thrown away: pull it back
					part.CFrame = CFrame.new(target)
				end
			end
			c.bp.Position = target
			c.bg.CFrame = rot
		end
	end
end

----------------------------------------------------------------
-- Summon / release
----------------------------------------------------------------
local function release()
	S.active = false
	if heartbeat then heartbeat:Disconnect() heartbeat = nil end
	for _, c in ipairs(claimed) do
		if c.bp then c.bp:Destroy() end
		if c.bg then c.bg:Destroy() end
		if c.part and c.part.Parent then c.part.CanCollide = c.oldCollide end
	end
	claimed = {}
	claimedSet = {}
	destroySkin()
	restoreHum()
	cam.CameraType = Enum.CameraType.Custom
	local hum = getHum()
	if hum then cam.CameraSubject = hum end
	lastSubject = nil
	if camPart then camPart:Destroy() camPart = nil end
	S.state = "landed"
	if launchBtn then launchBtn.Text = "Launch" end
	if buildBtn then buildBtn.Text = "Summon Rocket" end
	setStatus("released")
end

local function build()
	if S.busy or S.active then return end
	local root = getRoot()
	if not root then setStatus("no character") return end

	local parts = getToyParts()
	if #parts == 0 then setStatus("no toys found") return end

	S.busy = true
	setStatus("claiming toys...")
	local origin = root.CFrame
	local teleported = false

	for i = 1, math.min(#SL, #parts) do
		local part = parts[i]
		if part.Parent then
			-- only move if the toy is out of grab range
			if (part.Position - root.Position).Magnitude > 30 then
				root.CFrame = part.CFrame * CFrame.new(0, 4, 0)
				teleported = true
				task.wait(0.08)
			end
			if claim(part) then
				addToy(part, #claimed + 1)
			end
		end
	end
	if teleported then root.CFrame = origin end

	if #claimed == 0 then
		S.busy = false
		setStatus("no toys claimed")
		return
	end

	-- launch pad: ahead of you, on the ground
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	flat = flat.Magnitude > 1e-3 and flat.Unit or V(0, 0, -1)
	local spot = root.Position + flat * (S.size * 9)
	local ign = { lp.Character }
	local folder = getToyFolder()
	if folder then table.insert(ign, folder) end
	rayParams.FilterDescendantsInstances = ign
	local hit = workspace:Raycast(V(spot.X, root.Position.Y + 20, spot.Z), V(0, -500, 0), rayParams)
	padGround = hit and hit.Position.Y or (root.Position.Y - 3)
	padPos = V(spot.X, padGround, spot.Z)

	pos = V(padPos.X, padGround + REST_H * S.size, padPos.Z)
	vel = Vector3.zero
	tiltVec = Vector3.zero
	roll = 0
	intensity = 0

	camPart = Instance.new("Part")
	camPart.Name = "RocketCam"
	camPart.Anchored = true
	camPart.CanCollide = false
	camPart.CanQuery = false
	camPart.CanTouch = false
	camPart.Transparency = 1
	camPart.Size = V(1, 1, 1)
	camPart.CFrame = CFrame.new(pos)
	camPart.Parent = workspace

	if S.skin then buildSkin() end

	S.active = true
	buildBtn.Text = "Dismiss Rocket"
	setState("landed")
	heartbeat = RunService.Heartbeat:Connect(step)
	S.busy = false
end

