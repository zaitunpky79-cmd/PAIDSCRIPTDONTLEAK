-- Toy layout: 20 slots (priority: middle of the body first)
----------------------------------------------------------------
local SL = {}
for _, y in ipairs({ 0.5, -0.5, 1.5, -1.5, 2.5, -2.5 }) do
	table.insert(SL, { k = "body", y = y })
end
for _, y in ipairs({ 3.6, 4.6, 5.5 }) do -- nose cone
	table.insert(SL, { k = "body", y = y })
end
table.insert(SL, { k = "body", y = -3.3 }) -- engine
table.insert(SL, { k = "win" })
for i = 0, 3 do table.insert(SL, { k = "fin", a = i * math.pi / 2, r = 1.5, y = -2.2 }) end
for i = 0, 3 do table.insert(SL, { k = "fin", a = i * math.pi / 2, r = 2.5, y = -3.0 }) end
table.insert(SL, { k = "flame" })

local function slotLocal(s, flick)
	local k = s.k
	if k == "body" then
		return V(0, s.y, 0)
	elseif k == "win" then
		return V(0, 1.4, -1.0)
	elseif k == "fin" then
		return V(math.cos(s.a) * s.r, s.y, math.sin(s.a) * s.r)
	else
		return V(0, -4.4 - 0.9 * flick, 0)
	end
end

----------------------------------------------------------------
-- Toys
----------------------------------------------------------------
local function getToyFolder()
	return workspace:FindFirstChild(lp.Name .. "SpawnedInToys")
		or workspace:FindFirstChild("Ketik_Ketikketik4SpawnedInToys")
end

local function getToyParts()
	local parts = {}
	local folder = getToyFolder()
	if not folder then return parts end
	for _, toy in ipairs(folder:GetChildren()) do
		local sp = toy:FindFirstChild("SoundPart")
		if sp and sp:IsA("BasePart") then
			table.insert(parts, sp)
			if #parts >= MAX_TOYS then break end
		end
	end
	return parts
end

local function claim(part)
	-- The remote name/arguments may change when the game updates.
	return pcall(function()
		RS.GrabEvents.SetNetworkOwner:FireServer(part, part.CFrame)
	end)
end

-- does this client still own the part? (executor helper; unknown = false)
local function ownsPart(part)
	if isnetworkowner then
		local ok, r = pcall(isnetworkowner, part)
		if ok then return r end
	end
	return false
end

local function makeMovers(c)
	local part = c.part
	if not (c.bp and c.bp.Parent == part) then
		local bp = Instance.new("BodyPosition")
		bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bp.P = 25000
		bp.D = 1200
		bp.Position = part.Position
		bp.Parent = part
		c.bp = bp
	end
	if not (c.bg and c.bg.Parent == part) then
		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		bg.P = 25000
		bg.CFrame = part.CFrame
		bg.Parent = part
		c.bg = bg
	end
end

local function addToy(part, si)
	local c = { part = part, si = si, oldCollide = part.CanCollide }
	part.CanCollide = false
	makeMovers(c)
	table.insert(claimed, c)
	claimedSet[part] = c
	return c
end

-- drop destroyed toys and pick up new ones to fill the free slots
local function refill()
	for i = #claimed, 1, -1 do
		local c = claimed[i]
		if not c.part.Parent then
			claimedSet[c.part] = nil
			table.remove(claimed, i)
		end
	end
	if #claimed >= #SL then return end
	local used = {}
	for _, c in ipairs(claimed) do used[c.si] = true end
	for _, part in ipairs(getToyParts()) do
		if not claimedSet[part] then
			local si
			for i = 1, #SL do
				if not used[i] then si = i break end
			end
			if not si then break end
			if claim(part) then
				used[si] = true
				addToy(part, si)
			end
		end
	end
end

