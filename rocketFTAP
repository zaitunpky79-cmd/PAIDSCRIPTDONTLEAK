local function mk(parent, shape, size, cf, color, material, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	if shape then p.Shape = shape end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.Parent = parent
	return p
end

local function newModel(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	local root = mk(m, nil, V(0.2, 0.2, 0.2), CFrame.new(), Color3.new(), Enum.Material.SmoothPlastic, 1)
	m.PrimaryPart = root
	m.Parent = parent
	return m
end

local function destroySkin()
	if skin then
		skin.model:Destroy()
		skin = nil
	end
end

local function newEmitter(parent, fire, sz)
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.EmissionDirection = Enum.NormalId.Bottom
	e.Rotation = NumberRange.new(0, 360)
	if fire then
		e.Lifetime = NumberRange.new(0.35, 0.7)
		e.Speed = NumberRange.new(5 * sz, 9 * sz)
		e.SpreadAngle = Vector2.new(6, 6)
		e.Color = ColorSequence.new(Color3.fromRGB(255, 215, 90), Color3.fromRGB(255, 80, 20))
		e.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.9 * sz),
			NumberSequenceKeypoint.new(1, 0.15 * sz),
		})
		e.Transparency = NumberSequence.new(0.1, 1)
		e.LightEmission = 1
	else
		e.Lifetime = NumberRange.new(1.8, 3.0)
		e.Speed = NumberRange.new(1.5 * sz, 3.5 * sz)
		e.SpreadAngle = Vector2.new(20, 20)
		e.Color = ColorSequence.new(Color3.fromRGB(190, 190, 195), Color3.fromRGB(110, 110, 118))
		e.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.8 * sz),
			NumberSequenceKeypoint.new(1, 3.2 * sz),
		})
		e.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.45),
			NumberSequenceKeypoint.new(1, 1),
		})
		e.LightEmission = 0
	end
	e.Parent = parent
	return e
end

local function buildSkin()
	destroySkin()
	local sz = S.size
	local model = Instance.new("Model")
	model.Name = "RocketSkin"
	skin = { model = model }

	local WHITE = Color3.fromRGB(230, 233, 242)
	local RED = Color3.fromRGB(205, 50, 50)
	local DARK = Color3.fromRGB(60, 64, 78)
	local up = CFrame.Angles(0, 0, math.pi / 2) -- cylinder axis -> up

	local rocket = newModel(model, "Rocket")
	local function cyl(y, dia, len, color, material, tr)
		return mk(rocket, Enum.PartType.Cylinder, V(len * sz, dia * sz, dia * sz),
			CFrame.new(0, y * sz, 0) * up, color, material, tr)
	end

	-- hull with bands
	cyl(0, 1.9, 7.0, WHITE, Enum.Material.Metal)
	cyl(2.6, 1.95, 0.5, RED, Enum.Material.Metal)
	cyl(-2.6, 1.95, 0.5, DARK, Enum.Material.Metal)
	cyl(-0.6, 1.93, 0.18, DARK, Enum.Material.Metal)

	-- ogive nose cone (stacked, shrinking discs) + tip
	for i, w in ipairs({ 1.8, 1.4, 1.0, 0.62, 0.28 }) do
		cyl(3.75 + (i - 1) * 0.5, w, 0.55, RED, Enum.Material.Metal)
	end
	mk(rocket, Enum.PartType.Ball, V(0.3, 0.3, 0.3) * sz, CFrame.new(0, 6.0 * sz, 0), WHITE, Enum.Material.Metal)

	-- portholes (both sides)
	for _, zs in ipairs({ -1, 1 }) do
		mk(rocket, Enum.PartType.Ball, V(0.95, 0.95, 0.3) * sz, CFrame.new(0, 1.3 * sz, zs * 0.9 * sz), DARK, Enum.Material.Metal)
		mk(rocket, Enum.PartType.Ball, V(0.7, 0.7, 0.34) * sz, CFrame.new(0, 1.3 * sz, zs * 0.92 * sz),
			Color3.fromRGB(130, 230, 255), Enum.Material.Neon, 0.2)
	end

	-- 4 fins
	for i = 0, 3 do
		mk(rocket, nil, V(1.6, 2.8, 0.16) * sz,
			CFrame.Angles(0, i * math.pi / 2, 0) * CFrame.new(1.75 * sz, -3.1 * sz, 0),
			RED, Enum.Material.Metal)
	end

	-- engine bell + glowing rim
	cyl(-4.0, 1.2, 1.0, DARK, Enum.Material.Metal)
	cyl(-4.5, 1.0, 0.18, Color3.fromRGB(255, 140, 50), Enum.Material.Neon)
	skin.rocket = rocket

	-- flame (resized every frame) + nozzle for the particles
	skin.flameOuter = mk(model, Enum.PartType.Cylinder, V(1, 1, 1), CFrame.new(),
		Color3.fromRGB(255, 120, 30), Enum.Material.Neon, 0.4)
	skin.flameInner = mk(model, Enum.PartType.Cylinder, V(1, 1, 1), CFrame.new(),
		Color3.fromRGB(255, 240, 150), Enum.Material.Neon, 0.15)
	skin.glow = mk(model, Enum.PartType.Ball, V(1.2, 1.2, 1.2) * sz, CFrame.new(),
		Color3.fromRGB(255, 160, 60), Enum.Material.Neon, 0.6)
	skin.nozzle = mk(model, nil, V(0.5, 0.5, 0.5), CFrame.new(), Color3.new(), Enum.Material.SmoothPlastic, 1)
	skin.fire = newEmitter(skin.nozzle, true, sz)
	skin.smoke = newEmitter(skin.nozzle, false, sz)

	-- launch pad (stays on the ground when the rocket leaves)
	local function padDisc(dia, thick, y, color, material, tr)
		mk(model, Enum.PartType.Cylinder, V(thick * sz, dia * sz, dia * sz),
			CFrame.new(padPos.X, padGround + y * sz, padPos.Z) * up, color, material, tr)
	end
	padDisc(9.0, 0.15, 0.08, Color3.fromRGB(60, 64, 76), Enum.Material.Metal)
	padDisc(7.2, 0.17, 0.09, Color3.fromRGB(255, 210, 60), Enum.Material.Neon, 0.3)
	padDisc(6.6, 0.19, 0.10, Color3.fromRGB(45, 48, 60), Enum.Material.Metal)

	-- outline so you can always find it, even far away or behind things
	local hl = Instance.new("Highlight")
	hl.Adornee = model
	hl.FillTransparency = 1
	hl.OutlineColor = Color3.fromRGB(255, 200, 120)
	hl.OutlineTransparency = 0.25
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = model

	model.Parent = workspace
end

