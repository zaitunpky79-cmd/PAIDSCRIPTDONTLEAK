-- Apply neon effect to a pet model
local function applyNeonToModel(petModel, petData, isMega)
    if not petModel then return end
    if not PetRigs then return end  -- add this
    local pm = petModel:FindFirstChild("PetModel") or petModel
    local kindData = KindDB[petData.id]
    if not kindData or not kindData.neon_parts then 
        print("No neon parts for this pet")
        return 
    end
    
    print("Applying neon to:", petData.id, "Mega:", isMega or false)
    
    -- Apply neon to all neon parts
    for partName, config in pairs(kindData.neon_parts) do
        local part = PetRigs.get(pm).get_geo_part(pm, partName)
        if part then
            part.Material = Enum.Material.Neon
            if isMega then
                -- Mega neon - brighter colors
                local h, s, v = config.Color:ToHSV()
                part.Color = Color3.fromHSV(h, math.min(s * 1.3, 1), math.min(v * 1.4, 1))
