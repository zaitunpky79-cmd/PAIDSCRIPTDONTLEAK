preppyWearBtn.MouseButton1Click:Connect(function()
    local preppy = {"Unicorn Horn", "Pink Cat Ear Headphones", "Rainbow Maker", "2022 Birthday Cupcake Shoes"}
    local count = 0
    for _, n in ipairs(preppy) do
        local id = getPetWearId(n)
        if id then
            local PetAccessoryEquipHelper = Load("PetAccessoryEquipHelper")
            local wearEntry = InventoryDB.pet_accessories and InventoryDB.pet_accessories[id]
            if wearEntry then
                local wrappers = ClientData.get("pet_char_wrappers")
                if wrappers and #wrappers > 0 then
                    local petModel = wrappers[#wrappers].char
                    if petModel then
                        local asset = DownloadClient.promise_download_copy("PetAvatarResources", wearEntry.model_handle):expect()
                        PetAccessoryEquipHelper.equip_accessory({
                            pet_model = petModel,
                            accessory_base_asset = asset,
                            accessory_item_entry = wearEntry,
                            play_poof_effect = true,
                            is_mannequin = false,
                        })
                        count = count + 1
                    end
                end
            end
        end
        task.wait(0.1)
    end
    preppyWearBtn.Text = "✓ " .. count .. " added"
    task.wait(0.5)
    preppyWearBtn.Text = "Add Preppy PW"
end)

