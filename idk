----------------------------------------------------------------
-- Hand skeleton (hand space: palm center = origin, fingers = +y,
-- palm side = -z, thumb = +x for the right hand)
----------------------------------------------------------------
local FNAMES = { "index", "middle", "ring", "pinky" }
local FINGERS = {
	index = { base = V(0.75, 0.9, 0), len = { 0.9, 0.6, 0.5 } },
	middle = { base = V(0.25, 0.95, 0), len = { 1.0, 0.65, 0.5 } },
	ring = { base = V(-0.25, 0.9, 0), len = { 0.9, 0.6, 0.5 } },
	pinky = { base = V(-0.75, 0.8, 0), len = { 0.7, 0.45, 0.4 } },
}
local THUMB = { base = V(0.9, -0.6, 0), len = { 0.8, 0.6 } }
local FLEX = { math.rad(80), math.rad(100), math.rad(60) } -- full curl per joint

-- Gesture = curl (0 straight .. 1 fist) and spread per finger,
-- thumb = { dir1, flex1, dir2, flex2 } in degrees.
local function G(c, sp, th) return { c = c, sp = sp, th = th } end
local Z = { index = 0, middle = 0, ring = 0, pinky = 0 }
local FIST_THUMB = { -25, 30, -55, 45 }
local GEST = {
	rest = G({ index = 0.10, middle = 0.08, ring = 0.12, pinky = 0.15 },
		{ index = 0.12, middle = 0, ring = 0.06, pinky = 0.20 }, { 40, 10, 30, 0 }),
	up = G({ index = 1, middle = 1, ring = 1, pinky = 1 }, Z, { 10, 0, 5, 0 }),
	point = G({ index = 0, middle = 1, ring = 1, pinky = 1 }, Z, { 30, 10, 20, 0 }),
	middle = G({ index = 1, middle = 0, ring = 1, pinky = 1 }, Z, FIST_THUMB),
	peace = G({ index = 0, middle = 0, ring = 1, pinky = 1 },
		{ index = 0.22, middle = -0.20, ring = 0, pinky = 0 }, FIST_THUMB),
	leftIdle = G({ index = 0.30, middle = 0.35, ring = 0.40, pinky = 0.45 },
		{ index = 0.10, middle = 0, ring = 0.05, pinky = 0.15 }, { 25, 15, 20, 10 }),
}

local function newState(src)
	local s = { c = {}, sp = {}, th = {} }
	for _, n in ipairs(FNAMES) do
		s.c[n] = src.c[n]
		s.sp[n] = src.sp[n]
	end
	for i = 1, 4 do s.th[i] = src.th[i] end
	return s
end

local function lerpState(cur, tgt, k)
	for _, n in ipairs(FNAMES) do
		cur.c[n] += (tgt.c[n] - cur.c[n]) * k
		cur.sp[n] += (tgt.sp[n] - cur.sp[n]) * k
	end
	for i = 1, 4 do cur.th[i] += (tgt.th[i] - cur.th[i]) * k end
end

local handR = newState(GEST.rest)
local handL = newState(GEST.leftIdle)

-- joint positions of one hand (hand space, units)
local function handPoints(st, mirror)
	local pts = { W = V(0, -1.1, 0) } -- wrist
	for _, n in ipairs(FNAMES) do
		local f = FINGERS[n]
		local c, sp = st.c[n], st.sp[n]
		local beta = -sp * (f.base.X >= 0 and 1 or -1) -- spread away from the middle
		local cb, sb = math.cos(beta), math.sin(beta)
		local cur = f.base
		local list = { cur }
		local a = 0
		for i = 1, 3 do
			a += FLEX[i] * c
			local ca = math.cos(a)
			cur += V(-ca * sb, ca * cb, -math.sin(a)) * f.len[i]
			list[i + 1] = cur
		end
		pts[n] = list
	end

	local th = st.th
	local g1, a1 = math.rad(th[1]), math.rad(th[2])
	local g2, a2 = math.rad(th[3]), math.rad(th[4])
	local t0 = THUMB.base
	local t1 = t0 + V(math.sin(g1) * math.cos(a1), math.cos(g1) * math.cos(a1), -math.sin(a1)) * THUMB.len[1]
	local t2 = t1 + V(math.sin(g2) * math.cos(a2), math.cos(g2) * math.cos(a2), -math.sin(a2)) * THUMB.len[2]
	pts.thumb = { t0, t1, t2 }

	if mirror then -- left hand = mirrored right hand
		for k, v in pairs(pts) do
			if typeof(v) == "Vector3" then
				pts[k] = V(-v.X, v.Y, v.Z)
			else
				for i, p in ipairs(v) do v[i] = V(-p.X, p.Y, p.Z) end
			end
		end
	end
	return pts
end

