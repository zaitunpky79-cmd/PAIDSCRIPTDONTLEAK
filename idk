----------------------------------------------------------------
-- Animation + main loop
----------------------------------------------------------------
local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

local function startSlam()
	if not S.active or S.attack then return end
	S.attack = { t0 = tick(), dur = 1.5, from = handPosCur }
	setStatus("attack: slam")
end

local function step(dt)
	local root = getRoot()
	if not root then return end
	local t = tick()

	-- smoothed facing = the way you face
	local look = root.CFrame.LookVector
	local lookFlat = Vector3.new(look.X, 0, look.Z)
	if lookFlat.Magnitude > 1e-3 then
		local blended = sFace:Lerp(lookFlat.Unit, math.min(1, dt * 4))
		sFace = blended.Magnitude > 1e-3 and blended.Unit or lookFlat.Unit
	end

	-- follow: in front of you (facing you) or behind you
	if S.follow then
		local ignore = { lp.Character }
		local folder = getToyFolder()
		if folder then table.insert(ignore, folder) end
		rayParams.FilterDescendantsInstances = ignore

		local xz = root.Position + sFace * (S.dist * (S.front and 1 or -1))
		local hit = workspace:Raycast(Vector3.new(xz.X, root.Position.Y + 5, xz.Z), Vector3.new(0, -300, 0), rayParams)
		local gy = hit and hit.Position.Y or (root.Position.Y - 3)
		local target = Vector3.new(xz.X, gy, xz.Z)
		if (target - basePos).Magnitude > 250 then basePos = target end
		basePos = basePos:Lerp(target, math.min(1, dt * 3.5))
	end
	local faceDir = S.front and -sFace or sFace

	-- big hand animation ------------------------------------------
	local desired = (S.gesture == "rest") and REST_POS or PRESENT_POS
	local gestName = S.gesture
	local pitch, lean, lunge = 0, 0, 0
	local direct = nil
	local rotRate = 8

	local atk = S.attack
	if atk then
		local p = (t - atk.t0) / atk.dur
		gestName = "rest" -- open palm while slamming
		rotRate = 18
		if p >= 1 then
			S.attack = nil
			setStatus(("alive (%d toys)"):format(#claimed))
		else
			if p < 0.4 then -- wind up: raise the hand high
				local k = smooth(p / 0.4)
				direct = atk.from:Lerp(UP_POS, k)
				pitch = math.rad(-30) * k
			elseif p < 0.55 then -- strike
				local k = smooth((p - 0.4) / 0.15)
				direct = UP_POS:Lerp(HIT_POS, k)
				pitch = math.rad(-30 - 60 * k)
			elseif p < 0.75 then -- impact: hold + shake
				local q = (p - 0.55) / 0.2
				local sh = math.sin((p - 0.55) * 60) * 0.25 * (1 - q)
				direct = HIT_POS + V(0, sh * 0.5, sh)
				pitch = math.rad(-90)
			else -- recover
				local k = smooth((p - 0.75) / 0.25)
				direct = HIT_POS:Lerp(desired, k)
				pitch = math.rad(-90) * (1 - k)
			end
			local envelope = smooth((p - 0.2) / 0.3) * (1 - smooth((p - 0.75) / 0.25))
			lean = -math.rad(18) * envelope
			lunge = 0.8 * envelope
		end
	end

	if direct then
		handPosCur = direct
	else
		handPosCur = handPosCur:Lerp(desired, math.min(1, dt * 6))
	end

	-- pointing: roll the whole hand sideways. In front mode it points to the
	-- viewer's right; behind mode it needs a half turn so the thumb stays up.
	local roll, flip = 0, 0
	if gestName == "point" then
		if S.front then
			roll = math.rad(90)
		else
			roll = math.rad(-90)
			flip = math.pi
		end
	end
	local rotTarget = CFrame.Angles(pitch, 0, 0) * CFrame.Angles(0, 0, roll) * CFrame.Angles(0, flip, 0)
	handRotCur = handRotCur:Lerp(rotTarget, math.min(1, dt * rotRate))

	lerpState(handR, GEST[gestName], math.min(1, dt * 10))
	lerpState(handL, GEST.leftIdle, math.min(1, dt * 4))

	-- skeleton in world space -------------------------------------
	local sz = S.size
	local sH = sz * HAND_MUL
	local bob3 = V(0, math.sin(t * 1.5) * 0.15, 0)
	local pos0 = basePos + faceDir * (lunge * sz)
	local baseCF = CFrame.lookAt(pos0, pos0 + faceDir)
	local torsoWorld = baseCF * CFrame.new((PIV + bob3) * sz) * CFrame.Angles(lean, 0, 0)
	local function tp(rel) return torsoWorld:PointToWorldSpace(rel * sz) end

	local shR, shL = tp(SH_R), tp(SH_L)

	local hbR = baseCF * CFrame.new((handPosCur + bob3) * sz) * handRotCur
	local ptsR = handPoints(handR, false)
	local wristR = hbR:PointToWorldSpace(ptsR.W * sH)
	local elbowR = ik(shR, wristR, baseCF:VectorToWorldSpace(V(0.7, -1, 0.6)), ARM_L * sz)

	local leftU = V(-3.4, 3.8 + math.sin(t * 1.1 + 1) * 0.12, -3.3)
	local hbL = baseCF * CFrame.new(leftU * sz) * CFrame.Angles(0.15, 0, 0)
	local ptsL = handPoints(handL, true)
	local wristL = hbL:PointToWorldSpace(ptsL.W * sH)
	local elbowL = ik(shL, wristL, baseCF:VectorToWorldSpace(V(-0.7, -1, 0.6)), ARM_L * sz)

	-- detailed skin
	if S.skin and skin then
		skin.torso:PivotTo(torsoWorld)
		updateArmSkin(skin.armR, shR, elbowR, wristR)
		updateArmSkin(skin.armL, shL, elbowL, wristL)
		updateHandSkin(skin.handR, hbR, ptsR, sH)
		updateHandSkin(skin.handL, hbL, ptsL, sH)
	end

	-- toys follow the skeleton
	local function hw(hb, p) return hb:PointToWorldSpace(p * sH) end
	local P = {
		spineLow = tp(V(0, 0.2, 0.5)),
		spineMid = tp(V(0, 1.7, 0.5)),
		spineHigh = tp(V(0, 3.2, 0.5)),
		sternum = tp(V(0, 0.95, -2.14)),
		ribL3 = tp(V(-2.2, 1.2, -0.82)),
		ribR3 = tp(V(2.2, 1.2, -0.82)),
		ribL5 = tp(V(-2.05, 2.3, -0.73)),
		ribR5 = tp(V(2.05, 2.3, -0.73)),
		shL = shL,
		shR = shR,
		elbowR = elbowR,
		wristR = wristR,
		palmR = hw(hbR, V(0, 0, 0)),
		thumbTip = hw(hbR, ptsR.thumb[3]),
		indexTip = hw(hbR, ptsR.index[4]),
		middleTip = hw(hbR, ptsR.middle[4]),
		ringTip = hw(hbR, ptsR.ring[4]),
		pinkyTip = hw(hbR, ptsR.pinky[4]),
		elbowL = elbowL,
		palmL = hw(hbL, V(0, 0, 0)),
	}
	local rot = baseCF.Rotation
	for _, c in ipairs(claimed) do
		if c.part.Parent then
			c.bp.Position = P[c.slot]
			c.bg.CFrame = rot
		end
	end
end

----------------------------------------------------------------
-- Summon / release
----------------------------------------------------------------
local function release()
	S.active = false
	S.attack = nil
	if heartbeat then heartbeat:Disconnect() heartbeat = nil end
	for _, c in ipairs(claimed) do
		if c.bp then c.bp:Destroy() end
		if c.bg then c.bg:Destroy() end
		if c.part and c.part.Parent then c.part.CanCollide = c.oldCollide end
	end
	claimed = {}
	destroySkin()
	if buildBtn then buildBtn.Text = "Summon Susanoo" end
	setStatus("released")
end

local function build()
	if S.busy or S.active then return end
	local root = getRoot()
	if not root then setStatus("no character") return end

	local parts = getToyParts()
	if #parts == 0 then setStatus("no toys found") return end

	S.busy = true
	setStatus("claiming toys...")
	local origin = root.CFrame
	local teleported = false

	for i = 1, math.min(#slots, #parts) do
		local part = parts[i]
		if part.Parent then
			-- only move if the toy is out of grab range
			if (part.Position - root.Position).Magnitude > 30 then
				root.CFrame = part.CFrame * CFrame.new(0, 4, 0)
				teleported = true
				task.wait(0.08)
			end
			if claim(part) then
				local bp = Instance.new("BodyPosition")
				bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
				bp.P = 25000
				bp.D = 1200
				bp.Position = part.Position
				bp.Parent = part

				local bg = Instance.new("BodyGyro")
				bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
				bg.P = 25000
				bg.CFrame = part.CFrame
				bg.Parent = part

				local oldCollide = part.CanCollide
				part.CanCollide = false

				table.insert(claimed, {
					part = part, bp = bp, bg = bg,
					slot = slots[#claimed + 1], oldCollide = oldCollide,
				})
			end
		end
	end
	if teleported then root.CFrame = origin end

	if #claimed == 0 then
		S.busy = false
		setStatus("no toys claimed")
		return
	end

	-- appear in front of / behind you
	local look = root.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	sFace = flat.Magnitude > 1e-3 and flat.Unit or Vector3.new(0, 0, -1)
	basePos = root.Position + sFace * (S.dist * (S.front and 1 or -1)) - Vector3.new(0, 3, 0)
	handPosCur = REST_POS
	handRotCur = CFrame.new()
	handR = newState(GEST.rest)
	handL = newState(GEST.leftIdle)

	if S.skin then buildSkin() end

	S.active = true
	buildBtn.Text = "Dismiss Susanoo"
	setStatus(("alive (%d toys)"):format(#claimed))
	heartbeat = RunService.Heartbeat:Connect(step)
	S.busy = false
end

