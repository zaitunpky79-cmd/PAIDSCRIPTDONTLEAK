----------------------------------------------------------------
-- SKIN: detailed glowing model (client-side parts, only you see them)
----------------------------------------------------------------
local BONE_COLOR = Color3.fromRGB(125, 95, 255)
local HAND_COLOR = Color3.fromRGB(165, 135, 255)

local function newPart(parent, shape, color, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.Material = Enum.Material.Neon
	p.Color = color or BONE_COLOR
	p.Transparency = transparency or 0.12
	if shape then p.Shape = shape end
	p.Size = V(1, 1, 1)
	p.Parent = parent
	return p
end

-- a block stretched between two points
local function placeBone(part, a, b, thick)
	local d = b - a
	local len = d.Magnitude
	if len < 1e-3 then
		part.Size = V(thick, thick, 0.05)
		part.CFrame = CFrame.new(a)
		return
	end
	local dir = d / len
	local up = math.abs(dir.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	part.Size = V(thick, thick, len)
	part.CFrame = CFrame.lookAt((a + b) / 2, b, up)
end

local function setBall(part, pos, d)
	part.Size = V(d, d, d)
	part.CFrame = CFrame.new(pos)
end

-- ribcage + spine + sternum + collarbones (built once, moved as one model)
local function buildTorso(parent, size)
	local model = Instance.new("Model")
	model.Name = "Torso"
	local root = newPart(model)
	root.Size = V(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.CFrame = CFrame.new()
	model.PrimaryPart = root

	local function bone(a, b, thick, color)
		local p = newPart(model, nil, color)
		placeBone(p, a * size, b * size, thick * size)
	end

	local RIBS = {
		{ y = 0.35, a = 1.50 }, { y = 0.90, a = 1.95 }, { y = 1.45, a = 2.20 },
		{ y = 2.00, a = 2.25 }, { y = 2.55, a = 2.05 }, { y = 3.05, a = 1.60 },
	}
	local fronts = {}
	for k, r in ipairs(RIBS) do
		local b = 0.6 * r.a -- rib depth
		for _, side in ipairs({ -1, 1 }) do
			local prev
			for i = 0, 6 do
				local phi = math.pi * (0.04 + 0.96 * i / 6)
				local pt = V(
					side * r.a * math.sin(phi),
					r.y - 0.5 * (phi / math.pi),
					0.5 - b * (1 - math.cos(phi))
				)
				if prev then bone(prev, pt, 0.22) end
				prev = pt
			end
		end
		fronts[k] = V(0, r.y - 0.5, 0.5 - 2 * b)
	end

	-- sternum
	for k = 1, #fronts - 1 do
		bone(fronts[k], fronts[k + 1], 0.30, HAND_COLOR)
	end

	-- spine
	for i = 0, 8 do
		local p = newPart(model)
		p.Size = V(0.55, 0.42, 0.55) * size
		p.CFrame = CFrame.new(V(0, -0.2 + i * 0.5, 0.5) * size)
	end

	-- collarbones + shoulder joints
	for _, sh in ipairs({ SH_R, SH_L }) do
		bone(fronts[#fronts], sh, 0.26, HAND_COLOR)
		local ball = newPart(model, Enum.PartType.Ball, HAND_COLOR)
		setBall(ball, sh * size, 0.75 * size)
	end

	model.Parent = parent
	return model
end

local function newHandSkin(parent)
	local h = { meta = {}, phal = {}, knuckle = {} }
	for _, n in ipairs(FNAMES) do
		h.meta[n] = newPart(parent, nil, HAND_COLOR)
		h.phal[n] = {
			newPart(parent, nil, HAND_COLOR),
			newPart(parent, nil, HAND_COLOR),
			newPart(parent, nil, HAND_COLOR),
		}
		h.knuckle[n] = newPart(parent, Enum.PartType.Ball, BONE_COLOR)
	end
	h.meta.thumb = newPart(parent, nil, HAND_COLOR)
	h.phal.thumb = { newPart(parent, nil, HAND_COLOR), newPart(parent, nil, HAND_COLOR) }
	h.knuckle.thumb = newPart(parent, Enum.PartType.Ball, BONE_COLOR)
	h.plate = newPart(parent, nil, BONE_COLOR, 0.72) -- faint palm
	return h
end

local function newArmSkin(parent)
	return {
		upper = newPart(parent),
		fore1 = newPart(parent),
		fore2 = newPart(parent),
		elbow = newPart(parent, Enum.PartType.Ball, HAND_COLOR),
	}
end

local function destroySkin()
	if skin then
		skin.model:Destroy()
		skin = nil
	end
end

local function buildSkin()
	destroySkin()
	local model = Instance.new("Model")
	model.Name = "SusanooSkin"
	skin = { model = model }
	skin.torso = buildTorso(model, S.size)
	skin.armR = newArmSkin(model)
	skin.armL = newArmSkin(model)
	skin.handR = newHandSkin(model)
	skin.handL = newHandSkin(model)

	-- outline so you can always find it, even behind walls
	local hl = Instance.new("Highlight")
	hl.Adornee = model
	hl.FillColor = Color3.fromRGB(140, 110, 255)
	hl.FillTransparency = 0.85
	hl.OutlineColor = Color3.fromRGB(215, 195, 255)
	hl.OutlineTransparency = 0.15
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = model

	model.Parent = workspace
end

local function updateHandSkin(h, hb, pts, sH)
	local function w(p) return hb:PointToWorldSpace(p * sH) end
	local th = 0.2 * sH
	local wrist = w(pts.W)
	for _, n in ipairs(FNAMES) do
		local l = pts[n]
		placeBone(h.meta[n], wrist, w(l[1]), th)
		for j = 1, 3 do
			placeBone(h.phal[n][j], w(l[j]), w(l[j + 1]), th * (1.05 - 0.15 * j))
		end
		setBall(h.knuckle[n], w(l[1]), th * 1.5)
	end
	local l = pts.thumb
	placeBone(h.meta.thumb, wrist, w(l[1]), th * 1.1)
	for j = 1, 2 do
		placeBone(h.phal.thumb[j], w(l[j]), w(l[j + 1]), th * (1.0 - 0.15 * j))
	end
	setBall(h.knuckle.thumb, w(l[1]), th * 1.5)
	h.plate.Size = V(2.0 * sH, 1.9 * sH, 0.1 * sH)
	h.plate.CFrame = hb * CFrame.new(0, -0.1 * sH, 0.05 * sH)
end

local function updateArmSkin(a, s, e, wr)
	local th = 0.34 * S.size
	placeBone(a.upper, s, e, th)
	setBall(a.elbow, e, th * 1.6)
	local off = (wr - e):Cross(Vector3.yAxis)
	off = off.Magnitude > 1e-3 and off.Unit * th * 0.4 or V(0, 0, 0)
	placeBone(a.fore1, e + off, wr + off, th * 0.7)
	placeBone(a.fore2, e - off, wr - off, th * 0.7)
end

-- two-bone arm: elbow position from shoulder, wrist and a pole direction
local function ik(s, w, pole, L)
	local d = w - s
	local dist = d.Magnitude
	if dist < 1e-3 then return s end
	local dir = d / dist
	local mid = (s + w) / 2
	local h = 0
	if dist < 2 * L then h = math.sqrt(L * L - (dist / 2) ^ 2) end
	local perp = pole - dir * pole:Dot(dir)
	if perp.Magnitude < 1e-3 then return mid end
	return mid + perp.Unit * h
end

