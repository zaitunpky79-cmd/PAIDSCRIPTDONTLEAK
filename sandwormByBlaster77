local function toggleSummon()
	if alive then
		dismiss()
	else
		local n = tonumber(bricksBox.Text)
		if n and n >= CFG.MinBricks then CFG.Want = math.floor(n) else CFG.Want = math.huge end
		summon()
	end
	syncButtons()
end
local function setCalm()
	if not alive then return end
	hunt = nil
	notify("Calm", 2)
end
local function toggleControl()
	if not alive or (act and act.name == "emerge") then notify("Summon the worm first", 3) return end
	control = not control
	if control then hunt = nil end
	notify(control and "CONTROL on - move with your normal controls, abilities on the buttons / R F G V" or "Control off", 4)
	syncButtons()
end
local function toggleDive()
	notify(control and "CONTROL on - move with your normal controls, abilities on the buttons / R F G V" or "Control off", 4)
	syncButtons()
end
local function toggleDive()
	if not alive then notify("Summon the worm first", 3) return end
	dive = not dive
	syncButtons()
end
local function typedPlayer(required)
	local txt = nameBox.Text
	if txt:match("^%s*$") then
		if required then notify("Type a player name first", 3) end
		return nil, false
	end
	local pl = findPlayer(txt)
	if not pl then notify("Player not found: " .. txt, 3) return nil, true end
	if not targetHrp(pl) then notify("That player has no character", 3) return nil, true end
	return pl, false
end
local function huntTyped()
	if not alive or (act and act.name == "emerge") then notify("Summon the worm first", 3) return end
	if control then notify("Turn Control off first", 3) return end
	local pl = typedPlayer(true)
	if not pl then return end
	hunt = {pl = pl}
	notify("Hunting: " .. pl.DisplayName, 4)
end
local function doRoar() startAct("roar") end
local function doLunge()
	local pl, failed = typedPlayer(false)
	if failed then return end
	startAct("lunge", {pl = pl})
end
local function doSlam()
	local pl, failed = typedPlayer(false)
	if failed then return end
	startAct("slam", {pl = pl})
end
local function applySize()
	local n = parseSize(sizeBox.Text)
	if not n then
		notify("Type a size like 10x", 3)
		sizeBox.Text = string.format("%gx", CFG.Size)
		return
	end
	CFG.Size = n
	sizeBox.Text = string.format("%gx", n)
	if alive then
		allocate()
		applyColors()
	end
	notify(string.format("Size %gx", n), 3)
end

