-- brick roles: rings (body) + teeth (mouth) --------------------------------------------------------
local function dims()
	R0 = 1.4 * Kb * CFG.Size
	L = 0.95 * Kb * CFG.Size
end
local function allocate()
	local N = #pool
	dims()
	local teethTarget = clamp(math.floor(N * 0.22), 12, 600)
	local body = N - teethTarget
	nSeg = 21
	local M = clamp(math.ceil(L / (Kb * 0.95)), 1, 64) -- slats per segment (keeps the body solid at big sizes)
	local K = math.floor(body / (nSeg * M))
	if K < 3 then
		M = math.max(1, math.floor(body / (nSeg * 3)))
		K = math.floor(body / (nSeg * M))
		if K < 3 then
			nSeg = math.max(4, math.floor(body / (3 * M)))
			K = math.max(3, math.floor(body / (nSeg * M)))
		end
	end
	segM, segK = M, K
	local idx = 0
	P = {ring = {}, tooth = {}}
	for i = 1, nSeg do
		local r = {}
		for t = 1, M * K do idx += 1; r[t] = pool[idx] end
		P.ring[i] = r
	end
	local left = N - idx
	local Tn = clamp(math.floor(R0 * 0.45 / (Kb * 0.95) + 0.5), 1, 10) -- bricks per tooth (long teeth at big sizes)
	local Tc = math.floor(left / Tn)
	if Tc < 6 then Tn = 1; Tc = left end
	for k = 1, Tc do
		local th = {}
		for t = 1, Tn do idx += 1; th[t] = pool[idx] end
		P.tooth[k] = th
	end
	while idx < N do
		idx += 1
		P.tooth[#P.tooth + 1] = {pool[idx]}
	end
	jS = {}
	for i = 1, nSeg do jS[i] = {x = 0, y = 0, z = 0, vx = 0, vy = 0, vz = 0} end
	dustSize()
end

