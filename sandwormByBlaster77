local cutToken, winWas = 0, true
local function fade(lbl, to, secs)
	TweenService:Create(lbl, TweenInfo.new(secs, Enum.EasingStyle.Quad),
		{TextTransparency = to, TextStrokeTransparency = (to >= 1) and 1 or 0.4}):Play()
end
cutHooks.begin = function()
	cutToken += 1
	local tok = cutToken
	winWas = win.Visible
	win.Visible, openBtn.Visible = false, false
	barTop.Visible, barBot.Visible, skipBtn.Visible = true, true, true
	barTop.Size, barBot.Size = UDim2.new(1, 0, 0, 0), UDim2.new(1, 0, 0, 0)
	local ti = TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(barTop, ti, {Size = UDim2.new(1, 0, 0.12, 0)}):Play()
	TweenService:Create(barBot, ti, {Size = UDim2.new(1, 0, 0.12, 0)}):Play()
	task.delay(5.3, function()
		if cutToken ~= tok then return end
		titleLbl.Visible, subLbl.Visible = true, true
		fade(titleLbl, 0, 0.8)
		fade(subLbl, 0.2, 1.2)
	end)
	task.delay(8.2, function()
		if cutToken ~= tok then return end
		fade(titleLbl, 1, 0.9)
		fade(subLbl, 1, 0.9)
	end)
end
cutHooks.finish = function()
	cutToken += 1
	local tok = cutToken
	fade(titleLbl, 1, 0.3)
	fade(subLbl, 1, 0.3)
	skipBtn.Visible = false
	local ti = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(barTop, ti, {Size = UDim2.new(1, 0, 0, 0)}):Play()
	TweenService:Create(barBot, ti, {Size = UDim2.new(1, 0, 0, 0)}):Play()
	win.Visible, openBtn.Visible = winWas, true
	task.delay(0.8, function()
		if cutToken ~= tok then return end
		barTop.Visible, barBot.Visible, titleLbl.Visible, subLbl.Visible = false, false, false, false
	end)
end

do -- drag by title
	local dragging, startPos, startIn
	title.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, startPos, startIn = true, win.Position, i.Position
		end
	end)
	table.insert(conns, UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local dd = i.Position - startIn
			win.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + dd.X, startPos.Y.Scale, startPos.Y.Offset + dd.Y)
		end
	end))
	table.insert(conns, UIS.InputEnded:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end))
end

-- input / loop -------------------------------------------------------------
table.insert(conns, UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	local k = i.KeyCode
	if k == Enum.KeyCode.RightControl then win.Visible = not win.Visible
	elseif k == Enum.KeyCode.R then doRoar()
	elseif k == Enum.KeyCode.F then doLunge()
	elseif k == Enum.KeyCode.G then doSlam()
	elseif k == Enum.KeyCode.V then toggleDive() end
end))
table.insert(conns, lp.CharacterAdded:Connect(function(c)
	refChar(c)
	if alive then
		refreshFilters()
		if ride then carryAvatar(true); cam.CameraSubject = camPart end
	end
end))

local statT, filT = 0, 0
table.insert(conns, RunService.RenderStepped:Connect(function(dt)
	if alive then
		local ok, err = pcall(function()
			checkDrift()
			if camPart then step(math.min(dt, 0.033)) end
		end)
		if not ok then
			errT += dt
			if errT > 0.5 then
				errT = 0
				notify("⚠ script error: " .. tostring(err), 6)
				warn("[SandWorm] " .. tostring(err))
			end
		end
		filT += dt
		if filT > 2 then filT = 0; refreshFilters() end
	end
	statT += dt
	if statT > 0.5 then
		statT = 0
		syncButtons()
		if os.clock() > noticeUntil then
			if alive then
				local owned, n = visibleCount()
				local st = "Idle"
				if act then st = act.name:upper()
				elseif hunt then st = "Hunting " .. (hunt.pl.DisplayName or "?")
				elseif control then st = "Controlled"
				elseif dive then st = "Hidden" end
				statusLbl.Text = string.format("%s • %d bricks • %d/%d visible to others%s", st, n, owned, n, owned < n * 0.8 and " ⚠" or " ✔")
			else
				statusLbl.Text = string.format("Ready • uses every brick you own (min %d) • type a size like 10x", CFG.MinBricks)
			end
		end
	end
end))
table.insert(conns, RunService.Heartbeat:Connect(function() if alive then applyTargets() end end))
table.insert(conns, RunService.Stepped:Connect(function() if alive and #pool <= 1500 then applyTargets() end end))

