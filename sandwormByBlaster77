local function lerp(a, b, t) return a + (b - a) * t end
local function clamp(x, a, b) return math.clamp(x, a, b) end
local function smooth(x) x = clamp(x, 0, 1); return x * x * (3 - 2 * x) end
local function adiff(a, b) return (a - b + math.pi) % TAU - math.pi end
local function mix(a, b, k) return a + (b - a) * k end
local function ramp(t, a, b) return smooth((t - a) / (b - a)) end
local function sp(x, v, target, w, z, dt) -- damped spring: gives overshoot / follow-through
	local a = w * w * (target - x) - 2 * z * w * v
	v += a * dt
	x += v * dt
	return x, v
end

-- avatar rides inside the body (so the bricks keep belonging to you) -------------------------------
local function carryAvatar(on)
	if on then
		pcall(function() hrp.Anchored = false end)
		pcall(function() hum.PlatformStand = true end)
		avatarSaved = {}
		for _, d in ipairs(char:GetDescendants()) do
			if d:IsA("BasePart") then avatarSaved[d] = d.CanCollide; d.CanCollide = false end
		end
		pcall(function()
			local old = hrp:FindFirstChild("WormAvatarAntiG")
			if old then old:Destroy() end
			local bf = Instance.new("BodyForce")
			bf.Name = "WormAvatarAntiG"
			bf.Force = Vector3.new(0, hrp.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = hrp
		end)
	else
		pcall(function() local bf = hrp:FindFirstChild("WormAvatarAntiG"); if bf then bf:Destroy() end end)
		for d, c in pairs(avatarSaved) do pcall(function() d.CanCollide = c end) end
		avatarSaved = {}
		pcall(function() hum.PlatformStand = false end)
		pcall(function() hrp.Anchored = false end)
		pcall(function() hrp.AssemblyLinearVelocity = Vector3.zero end)
	end
end
local function setRide(on)
	if on == ride then return end
	ride = on
	carryAvatar(on)
	if on then
		cam.CameraSubject = camPart
		lp.CameraMaxZoomDistance = 3000
		lp.CameraMinZoomDistance = clamp(3.5 * R0, 12, 2900)
	else
		pcall(function() hrp.CFrame = CFrame.new(hp.X, gy1 + 8, hp.Z) end)
		avatarCF = nil
		cam.CameraSubject = hum
		if oldZoomMax then lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance = oldZoomMax, oldZoomMin end
	end
end

-- bricks (same selection as the other scripts, with public-server support) ----------------------------

local function toPart(o)
	if not o then return nil end
	if o:IsA("BasePart") then return o end
	return o:FindFirstChildWhichIsA("BasePart", true)
end
local function collect(container, from, to)
	local kids, out, seen = container:GetChildren(), {}, {}
	for i = from, math.min(to, #kids) do
		local p = toPart(kids[i])
		if p and not seen[p] then seen[p] = true; out[#out + 1] = p end
	end
	return out
end
-- who owns this brick? true = me, false = someone else, nil = unknown (attributes / value objects / folder named after a player)
local function ownerState(p)
	local function match(v)
		if v == nil then return nil end
		if typeof(v) == "Instance" then v = v.Name end
		if type(v) == "number" then return v == lp.UserId end
		v = tostring(v):lower()
		return v == lp.Name:lower() or v == lp.DisplayName:lower() or v == tostring(lp.UserId)
	end
	local inst = p
	for _ = 1, 4 do
		if not inst or inst == workspace then break end
		for _, nm in ipairs({"Owner", "owner", "Creator", "creator", "Player", "Builder"}) do
			local a = inst:GetAttribute(nm)
			if a ~= nil then return match(a) end
			local c = inst:FindFirstChild(nm)
			if c and c:IsA("ValueBase") then return match(c.Value) end
		end
		local pl = Players:FindFirstChild(inst.Name)
		if pl and pl:IsA("Player") then return pl == lp end
		inst = inst.Parent
	end
	return nil
end
local function usable(p, rep)
	if not p or not p.Parent or p:IsDescendantOf(char) then return false end
	if p.Anchored then rep.anchored += 1 return false end
	local okJ, joints = pcall(function() return p:GetJoints() end)
	if okJ and #joints > 0 then rep.welded += 1 return false end
	if ownerState(p) == false then rep.notOwned += 1 return false end
	if isnetworkowner then
		local okO, own = pcall(isnetworkowner, p)
		if okO and not own then rep.notOwned += 1 return false end
	end
	rep.ok += 1
	return true
end
-- public servers: the first bricks of workspace.Bricks belong to other players, so scan for OUR bricks (nearest first)
local function scanMine(root)
	local list = {}
	local tmp = {anchored = 0, welded = 0, notOwned = 0, ok = 0}
	local base = hrp.Position
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("BasePart") and not d:IsDescendantOf(char) and (not CFG.Strict or usable(d, tmp)) then
			list[#list + 1] = {d, (d.Position - base).Magnitude, ownerState(d) == true and 0 or 1}
		end
	end
	table.sort(list, function(x, y)
		if x[3] ~= y[3] then return x[3] < y[3] end
		return x[2] < y[2]
	end)
	local out = {}
	for i = CFG.From, math.min(CFG.To, #list) do out[#out + 1] = list[i][1] end
	return out
end
local function gather()
	local root = workspace:FindFirstChild("Bricks")
	if not root then return nil end
	local function attempt(ranged)
		local rep = {anchored = 0, welded = 0, notOwned = 0, ok = 0, total = 0}
		local out, seen, parents = {}, {}, {}
		local function consider(p)
			if p and not seen[p] and #out < CFG.Want then
				seen[p] = true
				rep.total += 1
				if not CFG.Strict then rep.ok += 1; out[#out + 1] = p
				elseif usable(p, rep) then out[#out + 1] = p end
			end
		end
		for _, p in ipairs(ranged) do parents[p.Parent] = true; consider(p) end
		if #out < CFG.Want then
			local extra = {}
			for par in pairs(parents) do
				for _, d in ipairs(par:GetChildren()) do
					if d:IsA("BasePart") and not seen[d] then extra[#extra + 1] = d end
				end
			end
			table.sort(extra, function(x, y) return (x.Position - hrp.Position).Magnitude < (y.Position - hrp.Position).Magnitude end)
			for _, p in ipairs(extra) do
				if #out >= CFG.Want then break end
				consider(p)
			end
		end
		return out, rep
	end
	local mine = root:FindFirstChild(lp.Name)
	local ranged = mine and collect(mine, CFG.From, CFG.To) or collect(root, CFG.From, CFG.To)
	if #ranged == 0 then
		local sub = root:FindFirstChild("master_ofbuilds")
		if sub then ranged = collect(sub, CFG.From, CFG.To) end
	end
	local out, rep = attempt(ranged)
	if #out < CFG.MinBricks then
		local alt = scanMine(root)
		if #alt > 0 then
			local out2, rep2 = attempt(alt)
			if #out2 > #out then return out2, rep2 end
		end
	end
	return out, rep
end



-- colors (LOCAL ONLY): sandy segmented body, bone teeth ------------------------------------------
local function paint(p, c, mat)
	pcall(function() p.Color = c; p.Material = mat or Enum.Material.SmoothPlastic end)
end
local function applyColors()
	local TOOTH = Color3.fromRGB(238, 232, 210)
	local SAND1, SAND2, DARK = Color3.fromRGB(196, 160, 104), Color3.fromRGB(168, 128, 80), Color3.fromRGB(120, 86, 52)
	for i, ring in ipairs(P.ring or {}) do
		local c = (i <= 3) and DARK or ((i % 2 == 0) and SAND1 or SAND2)
		for _, p in ipairs(ring) do paint(p, c) end
	end
	for _, tooth in ipairs(P.tooth or {}) do
		for _, p in ipairs(tooth) do paint(p, TOOTH) end
	end
end

local function groundAt(p, h)
	local res = workspace:Raycast(p + Vector3.new(0, h, 0), Vector3.new(0, -(h + 3000), 0), groundP)
	return res and res.Position.Y or p.Y
end
local function refreshFilters()
	local f = {char}
	if camPart then f[#f + 1] = camPart end
	for _, p in ipairs(pool) do f[#f + 1] = p end
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then f[#f + 1] = pl.Character end
	end
	groundP.FilterDescendantsInstances = f
end

