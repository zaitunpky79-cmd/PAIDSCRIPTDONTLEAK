local statT, hcT = 0, 0
table.insert(conns, RunService.RenderStepped:Connect(function(dt)
	if alive and parts and camPart then step(math.min(dt, 0.033)) end
	if alive then
		hcT += dt
		if hcT > 0.25 then healthCheck(hcT); hcT = 0 end
	end
	statT += dt
	if statT > 1 and os.clock() > noticeUntil then
		statT = 0
		if alive then
			local n, owned = 0, 0
			for _, name in ipairs(ORDER) do
				for _, p in ipairs(parts[name]) do
					n += 1
					if isnetworkowner then
						local ok, o = pcall(isnetworkowner, p)
						if ok and o then owned += 1 end
					end
				end
			end
			if isnetworkowner then
				statusLbl.Text = string.format("Mech online • %d/%d replicating • reserve %d • swapped %d", owned, n, #reserve, swapCount)
			else
				statusLbl.Text = string.format("Mech online • %d bricks • reserve %d • swapped %d", n, #reserve, swapCount)
			end
		else
			statusLbl.Text = string.format("Ready • master_ofbuilds [%d]-[%d] • Strict %s", CFG.From, CFG.To, CFG.Strict and "ON" or "OFF")
		end
	end
end))
local claimT = 0
