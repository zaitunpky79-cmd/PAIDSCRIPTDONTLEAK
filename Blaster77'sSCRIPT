--[[ BIPEDAL MECH (FE) | The Chosen One
  Built from ~100 REAL bricks: workspace.Bricks.master_ofbuilds:GetChildren()[From..To] (default 1-100).
  Only YOUR unanchored bricks are used - never anchored ones, never anything welded to somebody else's brick.
  Reference: white/orange armored mech - bulky torso, big pauldrons, twin arm cannons,
  heavy digitigrade legs (thigh -> knee -> shin -> wide foot).
  Groups (100): torso 16 | head 6 | pelvis 6 | backpack 4 | pauldrons 4+4 | upper arms 3+3 |
                cannons 6+6 | thighs 8+8 | shins 8+8 | feet 5+5
  Legs use 2-bone IK so the feet plant on the ground when walking.
  Keys: WASD move | Space jet-jump | Shift sprint | F hold = fire | G stomp | Z summon/dismiss
  Torso + cannons aim where your camera looks; legs face where you walk.
  FE: Strict mode only uses bricks that are unanchored, un-welded and network-owned by YOU (the only ones
  other players can see move). The status line shows how many bricks are really replicating.
  Colors (white/orange/blue) are LOCAL ONLY - other players see the bricks' real colors.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local lp = Players.LocalPlayer
local cam = workspace.CurrentCamera

if _G.ChosenOneMech then pcall(_G.ChosenOneMech) end

local CFG = {From = 1, To = 100, Size = 1, Recolor = true, Strict = true, Want = 120}
local TAU = math.pi * 2

-- layout -------------------------------------------------------------------
local ORDER = {"torso", "head", "pelvis", "pack", "shL", "shR", "uaL", "uaR", "gunL", "gunR", "thL", "thR", "shinL", "shinR", "footL", "footR"}
local BASE = {torso = 16, head = 6, pelvis = 6, pack = 4, shL = 4, shR = 4, uaL = 3, uaR = 3, gunL = 6, gunR = 6,
	thL = 8, thR = 8, shinL = 8, shinR = 8, footL = 5, footR = 5}
local LT, LS, LU, LG = 4.8, 4.8, 2.6, 6.5 -- thigh, shin, upper arm, cannon lengths (units)
local DIM = {
	torso = Vector3.new(9, 6, 6), head = Vector3.new(3.4, 2.6, 3.4), pelvis = Vector3.new(5.6, 2.2, 3.6),
	pack = Vector3.new(4.2, 3.2, 1.6), shL = Vector3.new(3.2, 3, 3.6), shR = Vector3.new(3.2, 3, 3.6),
	uaL = Vector3.new(1.8, LU, 1.8), uaR = Vector3.new(1.8, LU, 1.8), gunL = Vector3.new(2, LG, 2), gunR = Vector3.new(2, LG, 2),
	thL = Vector3.new(3.4, LT, 3.2), thR = Vector3.new(3.4, LT, 3.2), shinL = Vector3.new(2.8, LS, 2.6), shinR = Vector3.new(2.8, LS, 2.6),
	footL = Vector3.new(3.6, 1.4, 5), footR = Vector3.new(3.6, 1.4, 5),
}
local SL, LIFT, H0 = 5.0, 1.7, 8.2 -- stride, foot lift, pelvis height (units)

-- state --------------------------------------------------------------------
local char, hrp, hum
local alive, sprint, fireHeld, fireToggle = false, false, false, false
local parts, grids, used, saved, orient, targets = nil, {}, {}, {}, {}, {}
local camPart, flashes = nil, {}
local Kauto = 1.6
local pos, yaw, vy, ph, amt, airW, twistS, cr = Vector3.zero, 0, 0, 0, 0, 0, 0, 0
local grounded = true
local act, shake = nil, 0
local fireT, fireSide, rec = 0, 1, {0, 0}
local reserve, lostT, swapCount = {}, {}, 0
local statusLbl, noticeUntil = nil, 0
local conns = {}
local rayP = RaycastParams.new()
rayP.FilterType = Enum.RaycastFilterType.Exclude
local oldZoomMax, oldZoomMin = nil, nil

local function notify(txt, secs)
	if statusLbl then statusLbl.Text = txt end
	noticeUntil = os.clock() + (secs or 3)
end
local function refChar(c)
	char = c
	hrp = c:WaitForChild("HumanoidRootPart")
	hum = c:WaitForChild("Humanoid")
end
refChar(lp.Character or lp.CharacterAdded:Wait())

local function lerp(a, b, t) return a + (b - a) * t end
local function smooth(x) x = math.clamp(x, 0, 1); return x * x * (3 - 2 * x) end
local function adiff(a, b) return (a - b + math.pi) % TAU - math.pi end

-- bricks -------------------------------------------------------------------
local function toPart(o)
	if not o then return nil end
	if o:IsA("BasePart") then return o end
	return o:FindFirstChildWhichIsA("BasePart", true)
end
-- ONLY bricks inside workspace.Bricks.master_ofbuilds are ever touched.
local function myFolder()
	local root = workspace:FindFirstChild("Bricks")
	if not root then return nil end
	return root:FindFirstChild("master_ofbuilds") or root:FindFirstChild(lp.Name)
end

-- "foreign" = welded (directly or through a chain) to a part that is NOT in my folder
local function foreignWeld(p, mine)
	local ok, conn = pcall(function() return p:GetConnectedParts(true) end)
	if not ok then return false end
	for _, c in ipairs(conn) do
		if c ~= p and not c:IsDescendantOf(mine) then return true end
	end
	return false
end

-- usable = mine, UNANCHORED, not welded to anyone's brick, and my client owns its physics
local function usable(p, mine, rep)
	if not p or not p.Parent or p:IsDescendantOf(char) then return false end
	if p.Anchored then rep.anchored += 1 return false end
	local root = p.AssemblyRootPart
	if root and root.Anchored then rep.anchored += 1 return false end
	if foreignWeld(p, mine) then rep.foreign += 1 return false end
	local okJ, joints = pcall(function() return p:GetJoints() end)
	if okJ and #joints > 0 then rep.welded += 1 return false end
	if isnetworkowner then
		local okO, own = pcall(isnetworkowner, p)
		if okO and not own then rep.notOwned += 1 return false end
	end
	rep.ok += 1
	return true
end

local function gather()
	local mine = myFolder()
	if not mine then return nil end
	local rep = {anchored = 0, welded = 0, foreign = 0, notOwned = 0, ok = 0, total = 0}
	local kids, out, seen = mine:GetChildren(), {}, {}
	local function consider(o)
		local p = toPart(o)
		if p and not seen[p] and p:IsDescendantOf(mine) then
			seen[p] = true
			rep.total += 1
			if not CFG.Strict then rep.ok += 1; out[#out + 1] = p
			elseif usable(p, mine, rep) then out[#out + 1] = p end
		end
	end
	-- the range you chose: master_ofbuilds:GetChildren()[From..To]
	for i = CFG.From, math.min(CFG.To, #kids) do consider(kids[i]) end
	-- top up (reserve) with the nearest other bricks from MY folder only
	if #out < CFG.Want then
		local extra = {}
		for i, o in ipairs(kids) do
			if i < CFG.From or i > CFG.To then
				local p = toPart(o)
				if p and not seen[p] then extra[#extra + 1] = p end
			end
		end
		table.sort(extra, function(x, y) return (x.Position - hrp.Position).Magnitude < (y.Position - hrp.Position).Magnitude end)
		for _, p in ipairs(extra) do
			if #out >= CFG.Want then break end
			consider(p)
		end
	end
	return out, rep
end

-- pack n bricks into a box: returns n cell centres (unit space)
local function buildCells(n, d)
	local best, bx, by, bz = math.huge, 1, 1, n
	for nx = 1, n do
		for ny = 1, n do
			local nz = math.ceil(n / (nx * ny))
			local total = nx * ny * nz
			if total <= n * 2 then
				local cw, ch, cd = d.X / nx, d.Y / ny, d.Z / nz
				local cost = math.max(cw, ch, cd) / math.min(cw, ch, cd) + 0.6 * (total - n)
				if cost < best then best, bx, by, bz = cost, nx, ny, nz end
			end
		end
	end
	local cells = {}
	for iz = 1, bz do for iy = 1, by do for ix = 1, bx do
		cells[#cells + 1] = Vector3.new(((ix - 0.5) / bx - 0.5) * d.X, ((iy - 0.5) / by - 0.5) * d.Y, ((iz - 0.5) / bz - 0.5) * d.Z)
	end end end
	local out = {}
	for i = 1, n do out[i] = cells[math.floor((i - 0.5) * #cells / n) + 1] end
	return out
end

-- colors (LOCAL ONLY) ------------------------------------------------------
local WHITE, ORANGE = Color3.fromRGB(238, 238, 242), Color3.fromRGB(236, 118, 28)
local DARK, BLUE = Color3.fromRGB(44, 47, 56), Color3.fromRGB(70, 160, 255)
local function stripe(i) return (i % 3 == 0) and ORANGE or WHITE end
local PAINT = {
	torso = function(i) return i == 1 and BLUE or stripe(i) end, head = function(i) return i == 1 and BLUE or WHITE end,
	pelvis = function() return DARK end, pack = stripe, shL = stripe, shR = stripe,
	uaL = function() return DARK end, uaR = function() return DARK end,
	gunL = function(i) return i == 1 and ORANGE or DARK end, gunR = function(i) return i == 1 and ORANGE or DARK end,
	thL = stripe, thR = stripe, shinL = stripe, shinR = stripe,
	footL = function(i) return i <= 2 and DARK or WHITE end, footR = function(i) return i <= 2 and DARK or WHITE end,
}
local function setColors(on)
	if not parts then return end
	if on then
		for _, name in ipairs(ORDER) do
			for i, p in ipairs(parts[name]) do
				local c = PAINT[name](i)
				pcall(function()
					p.Color = c
					if c == BLUE then p.Material = Enum.Material.Neon end
				end)
			end
		end
	else
		for _, s in ipairs(saved) do
			pcall(function() s.p.Color = s.color; s.p.Material = s.material end)
		end
	end
end

-- summon / dismiss ---------------------------------------------------------
local function dismiss()
	for _, s in ipairs(saved) do
		local p = s.p
		if p and p.Parent then
			pcall(function()
				local bf = p:FindFirstChild("MechAntiG")
				if bf then bf:Destroy() end
				p.CFrame = s.cf
				p.Anchored = s.anchored
				p.CanCollide = s.collide
				p.Color, p.Material = s.color, s.material
				p.AssemblyLinearVelocity = Vector3.zero
			end)
		end
	end
	if camPart then camPart:Destroy() end
	for _, f in ipairs(flashes) do f:Destroy() end
	camPart, flashes, parts, grids, used, saved, orient, targets = nil, {}, nil, {}, {}, {}, {}, {}
	alive, act = false, nil
	reserve, lostT, swapCount = {}, {}, 0
	pcall(function() hum.Sit = false end)
	pcall(function() hrp.Anchored = false end)
	cam.CameraSubject = hum
	if oldZoomMax then lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance = oldZoomMax, oldZoomMin end
end

local function summon()
	if alive then return end
	local list, rep = gather()
	if not list then notify("✘ workspace.Bricks.master_ofbuilds not found") return end
	local N = math.min(#list, 160)
	if N < 40 then
		notify(string.format("✘ Only %d usable bricks (of %d checked): %d anchored, %d welded to others' bricks, %d welded, %d not yours. Stand next to your loose bricks.",
			#list, rep.total, rep.anchored, rep.foreign, rep.welded, rep.notOwned), 9)
		return
	end
	local reserveN = math.min(20, math.floor(N * 0.15))
	local mainN = N - reserveN
	local counts, tot = {}, 0
	for _, k in ipairs(ORDER) do counts[k] = math.max(1, math.round(BASE[k] * mainN / 100)); tot += counts[k] end
	counts.torso += mainN - tot
	if counts.torso < 3 then notify("✘ Range too small for the layout") return end

	parts, grids, used, saved, orient, targets = {}, {}, {}, {}, {}, {}
	local idx, anchoredCount = 0, 0
	for _, k in ipairs(ORDER) do
		parts[k] = {}
		for i = 1, counts[k] do idx += 1; parts[k][i] = list[idx] end
		-- long side of the bricks lines up with the longest side of the box
		local d = DIM[k]
		local axis = (d.Y >= d.X and d.Y >= d.Z) and "y" or (d.X >= d.Z and "x" or "z")
		grids[k] = {cells = buildCells(counts[k], d),
			rot = axis == "x" and CFrame.Angles(0, 0, -math.pi / 2) or axis == "z" and CFrame.Angles(math.pi / 2, 0, 0) or CFrame.new()}
	end
	reserve, lostT, swapCount = {}, {}, 0
	for i = idx + 1, N do reserve[#reserve + 1] = list[i] end
	local sumLong = 0
	for i = 1, N do
		local p = list[i]
		used[i] = p
		saved[i] = {p = p, cf = p.CFrame, anchored = p.Anchored, collide = p.CanCollide, color = p.Color, material = p.Material}
		local s, m = p.Size, math.max(p.Size.X, p.Size.Y, p.Size.Z)
		sumLong += m
		if s.X == m and s.X > s.Y then orient[p] = CFrame.Angles(0, 0, math.pi / 2)
		elseif s.Z == m and s.Z > s.Y then orient[p] = CFrame.Angles(-math.pi / 2, 0, 0)
		else orient[p] = CFrame.new() end
		if p.Anchored then anchoredCount += 1 end
		pcall(function() p.Anchored = false; p.CanCollide = false end)
		pcall(function()
			local bf = Instance.new("BodyForce")
			bf.Name = "MechAntiG"
			bf.Force = Vector3.new(0, p.AssemblyMass * workspace.Gravity, 0)
			bf.Parent = p
		end)
	end
	Kauto = math.clamp((sumLong / N) / 2.5, 0.6, 8)
	pcall(function() lp.MaximumSimulationRadius = math.huge end)
	pcall(function() sethiddenproperty(lp, "SimulationRadius", math.huge) end)

	camPart = Instance.new("Part")
	camPart.Anchored, camPart.CanCollide, camPart.Transparency, camPart.Size, camPart.CanQuery = true, false, 1, Vector3.one, false
	camPart.Parent = workspace
	for i = 1, 2 do
		local f = Instance.new("Part")
		f.Anchored, f.CanCollide, f.CanQuery, f.CanTouch = true, false, false, false
		f.Material, f.Color, f.Shape, f.Transparency = Enum.Material.Neon, Color3.fromRGB(255, 200, 80), Enum.PartType.Ball, 1
		f.Parent = workspace
		flashes[i] = f
	end
	local f = {char, camPart, flashes[1], flashes[2]}
	for _, p in ipairs(used) do f[#f + 1] = p end
	rayP.FilterDescendantsInstances = f

	local K = Kauto * CFG.Size
	oldZoomMax, oldZoomMin = lp.CameraMaxZoomDistance, lp.CameraMinZoomDistance
	lp.CameraMaxZoomDistance = 3000
	lp.CameraMinZoomDistance = math.min(14 * K, 2900)
	hrp.Anchored = true
	pcall(function() hum.Sit = true end)
	cam.CameraSubject = camPart

	local look = hrp.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)
	pos = hrp.Position + look * 16 * K
	vy, ph, amt, airW, twistS, cr, rec = 0, 0, 0, 0, 0, 0, {0, 0}
	alive = true
	if CFG.Recolor then setColors(true) end
	notify(anchoredCount > 0
		and string.format("⚠ %d/%d bricks anchored - others may not see movement", anchoredCount, idx)
		or string.format("✔ Mech online (%d bricks + %d reserve)", idx, reserveN), 5)
end

-- drawing ------------------------------------------------------------------
local function place(p, cf) targets[p] = cf * orient[p] end
local function applyTargets()
	for p, cf in pairs(targets) do
		if p.Parent then
			p.CFrame = cf
			p.AssemblyLinearVelocity = Vector3.zero
			p.AssemblyAngularVelocity = Vector3.zero
		end
	end
end
local function boneCF(a, b, side)
	local dir = b - a
	if dir.Magnitude < 1e-3 then dir = Vector3.new(0, -1, 0) end
	dir = dir.Unit
	local x = side - dir * side:Dot(dir)
	if x.Magnitude < 1e-3 then x = Vector3.xAxis end
	return CFrame.fromMatrix((a + b) / 2, x.Unit, dir)
end

local function stompS(tt)
	if tt < 0.5 then return smooth(tt / 0.5)
	elseif tt < 0.65 then return 1
	elseif tt < 0.78 then return 1 - ((tt - 0.65) / 0.13) ^ 2 end
	return 0
end

-- Bricks other players steal / knock away are swapped for spare bricks I still own.
local function healthCheck(dt)
	if not parts then return end
	local K = Kauto * CFG.Size
	local mine = myFolder()
	local function bad(p)
		if not p.Parent then return true end
		local root = p.AssemblyRootPart
		if root and root.Anchored then return true end
		if mine and foreignWeld(p, mine) then return true end
		if isnetworkowner then
			local ok, own = pcall(isnetworkowner, p)
			if ok and not own then return true end
		end
		local tg = targets[p]
		return tg ~= nil and (p.Position - tg.Position).Magnitude > 4 * K
	end
	for i = #reserve, 1, -1 do
		if bad(reserve[i]) then table.remove(reserve, i) end
	end
	for _, name in ipairs(ORDER) do
		local list = parts[name]
		for i, p in ipairs(list) do
			if bad(p) then
				lostT[p] = (lostT[p] or 0) + dt
				if lostT[p] > 0.4 and #reserve > 0 then
					list[i] = table.remove(reserve)
					targets[p] = nil
					swapCount += 1
				end
			else
				lostT[p] = 0
			end
		end
	end
end

local function step(dt)
	local K = Kauto * CFG.Size
	local function T(x, y, z) return CFrame.new(x * K, y * K, z * K) end
	local function cluster(name, cf, K2)
		local g, list = grids[name], parts[name]
		for i, p in ipairs(list) do
			local c = g.cells[i]
			place(p, cf * CFrame.new(c.X * K, c.Y * K, c.Z * K) * g.rot)
		end
	end
	local t = os.clock()
	local cl = cam.CFrame.LookVector
	local camYaw, camPitch = math.atan2(-cl.X, -cl.Z), math.asin(math.clamp(cl.Y, -1, 1))
	local dir = hum.MoveDirection
	local moving = dir.Magnitude > 0.1
	local runM = sprint and 1.7 or 1
	local speed = 7 * K * runM
	if act then speed *= 0.2 end

	-- facing / locomotion
	local turning = false
	if moving then
		pos += Vector3.new(dir.X, 0, dir.Z).Unit * speed * dt
		yaw += adiff(math.atan2(-dir.X, -dir.Z), yaw) * math.min(1, dt * 4)
	else
		local d2 = adiff(camYaw, yaw)
		if math.abs(d2) > 1.1 then
			turning = true
			yaw += math.sign(d2) * math.min(math.abs(d2), 1.8 * dt)
		end
	end
	local amtT = act and 0 or (moving and 1 or (turning and 0.55 or 0))
	amt = lerp(amt, amtT, math.min(1, dt * 6))
	local rate = moving and (0.6 * (speed / K) / SL) or (turning and 0.4 or 0)
	ph = (ph + rate * dt) % 1

	-- physics
	local wasAir = not grounded
	vy -= 150 * dt
	local newY = pos.Y + vy * dt
	local hit = workspace:Raycast(Vector3.new(pos.X, pos.Y + 40 * K, pos.Z), Vector3.new(0, -3000, 0), rayP)
	local gy = hit and hit.Position.Y or pos.Y - 1000
	if newY <= gy then
		if wasAir and vy < -40 then
			cr = math.clamp(-vy / 90, 0.3, 1)
			shake = math.max(shake, math.clamp(-vy / 60, 0.5, 2))
		end
		newY, vy, grounded = gy, 0, true
	else
		grounded = false
	end
	pos = Vector3.new(pos.X, newY, pos.Z)
	airW = lerp(airW, grounded and 0 or 1, math.min(1, dt * 12))

	-- actions: stomp
	local stompLean = 0
	if act then
		act.t += dt
		local S = stompS(act.t)
		stompLean = act.t < 0.65 and -0.12 * S or (act.t < 0.9 and 0.2 or 0)
		if act.t >= 0.78 and not act.hit then act.hit = true; shake = 2.6; cr = 1 end
		if act.t >= 1.2 then act = nil end
	end
	cr *= math.exp(-6 * dt)

	-- firing
	local firing = fireHeld or fireToggle
	if firing then
		fireT += dt
		if fireT > 0.14 then
			fireT = 0
			fireSide = 3 - fireSide
			rec[fireSide] = 1
			shake = math.max(shake, 0.3)
		end
	end
	rec[1] = math.max(0, rec[1] - dt * 8)
	rec[2] = math.max(0, rec[2] - dt * 8)

	-- body frames
	local H = H0 - 0.55 * amt * (0.5 + 0.5 * math.cos(4 * math.pi * ph)) - cr * 2.4
	local lean = 0.07 * amt * runM + stompLean - 0.05 * (rec[1] + rec[2])
	local roll = math.sin(TAU * ph) * 0.035 * amt
	local pelvisCF = CFrame.new(pos + Vector3.new(0, H * K, 0)) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-lean * 0.4, 0, roll)
	twistS = lerp(twistS, math.clamp(adiff(camYaw, yaw), -1.9, 1.9), math.min(1, dt * 8))
	local torsoCF = pelvisCF * T(0, 1, 0) * CFrame.Angles(-lean * 0.6, twistS, -roll * 1.6) * T(0, 3, 0)
	local breathe = math.sin(t * 1.4) * 0.03
	torsoCF *= CFrame.Angles(breathe, 0, 0)

	for _, r in ipairs(reserve) do targets[r] = CFrame.new(pelvisCF.Position) end
	cluster("pelvis", pelvisCF * T(0, 0.1, 0))
	cluster("torso", torsoCF)
	cluster("pack", torsoCF * T(0, 1, 3.6))
	local headCF = torsoCF * T(0, 3.2, -1.4)
		* CFrame.Angles(-math.clamp(camPitch, -0.3, 0.3) * 0.6, math.clamp(adiff(camYaw, yaw + twistS), -0.5, 0.5) * 0.6, 0)
	cluster("head", headCF)

	-- legs (2-bone IK, knees forward)
	local groundBase = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	local fwd = pelvisCF.LookVector
	local function leg(side, th, sn, ft)
		local phl = (ph + (side > 0 and 0.5 or 0)) % 1
		local fx, fy, pitch = 0, 0, 0
		if phl < 0.6 then
			fx = lerp(SL / 2, -SL / 2, phl / 0.6)
		else
			local u = (phl - 0.6) / 0.4
			fx, fy, pitch = lerp(-SL / 2, SL / 2, smooth(u)), math.sin(math.pi * u) * LIFT, lerp(-0.3, 0.35, u)
		end
		fx, fy, pitch = fx * amt, fy * amt, pitch * amt
		fx, fy, pitch = lerp(fx, -1.0, airW), lerp(fy, 3.2, airW), lerp(pitch, -0.2, airW)
		if act and side > 0 then
			local S = stompS(act.t)
			fx, fy, pitch = lerp(fx, 2.6, S), lerp(fy, 5.0, S), lerp(pitch, 0.3, S)
		end
		local hipW = (pelvisCF * T(side * 2.7, -0.2, 0)).Position
		local ankle = (groundBase * T(side * 2.9, fy + 0.7, -fx)).Position
		local v = ankle - hipW
		local lt, ls = LT * K, LS * K
		local dist = math.clamp(v.Magnitude, 0.4 * K, (lt + ls) * 0.999)
		local vu = v.Unit
		ankle = hipW + vu * dist
		local along = (lt * lt - ls * ls + dist * dist) / (2 * dist)
		local hgt = math.sqrt(math.max(0, lt * lt - along * along))
		local pole = fwd - vu * fwd:Dot(vu)
		pole = pole.Magnitude > 1e-3 and pole.Unit or fwd
		local knee = hipW + vu * along + pole * hgt
		cluster(th, boneCF(hipW, knee, pelvisCF.RightVector))
		cluster(sn, boneCF(knee, ankle, pelvisCF.RightVector))
		cluster(ft, CFrame.new(ankle) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0))
	end
	leg(-1, "thL", "shinL", "footL")
	leg(1, "thR", "shinR", "footR")

	-- arms + cannons (aim at the camera direction)
	local lx = torsoCF:VectorToObjectSpace(cl)
	local ay = math.clamp(math.atan2(-lx.X, -lx.Z), -0.9, 0.9)
	local ap = math.clamp(math.asin(math.clamp(lx.Y, -1, 1)), -0.6, 0.7)
	local muzzle = {}
	local function arm(side, sh, ua, gun, ri)
		local r = rec[ri]
		local shoulderW = (torsoCF * T(side * 5.4, 1.6, 0.2)).Position
		cluster(sh, torsoCF * T(side * 5.6, 2.4, 0) * CFrame.Angles(-0.12 * r, 0, 0))
		local ud = Vector3.new(side * 0.2, -0.75 + 0.3 * r, -0.62 + 0.35 * r).Unit
		local elbowW = shoulderW + torsoCF:VectorToWorldSpace(ud) * LU * K
		cluster(ua, boneCF(shoulderW, elbowW, torsoCF.RightVector))
		local yy = ay - side * 0.04
		local gl = Vector3.new(-math.sin(yy) * math.cos(ap), math.sin(ap), -math.cos(yy) * math.cos(ap))
		local gw = torsoCF:VectorToWorldSpace(gl)
		local gStart = elbowW - gw * 1.4 * K * r
		local gEnd = gStart + gw * LG * K
		cluster(gun, boneCF(gStart, gEnd, torsoCF.RightVector))
		muzzle[ri] = gEnd
	end
	arm(-1, "shL", "uaL", "gunL", 1)
	arm(1, "shR", "uaR", "gunR", 2)

	for i = 1, 2 do
		local f = flashes[i]
		local r = rec[i]
		f.Size = Vector3.one * (1.1 + r) * K
		f.Position = muzzle[i]
		f.Transparency = 1 - math.clamp((r - 0.35) * 1.4, 0, 0.9)
	end

	shake = math.max(0, shake - dt * 3)
	camPart.Position = pos + Vector3.new(0, (H + 5) * K, 0)
		+ Vector3.new(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * shake * K * 0.35

	-- ownership follows the player's CHARACTER, so carry it along inside the mech
	hrp.CFrame = CFrame.new(pos + Vector3.new(0, (H + 2) * K, 0)) * CFrame.Angles(0, yaw + twistS, 0)
	hrp.AssemblyLinearVelocity = Vector3.zero

	applyTargets()
end

