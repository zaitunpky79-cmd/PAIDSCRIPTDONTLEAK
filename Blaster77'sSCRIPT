table.insert(conns, UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	local k = i.KeyCode
	if k == Enum.KeyCode.RightControl then gui.Enabled = not gui.Enabled
	elseif k == Enum.KeyCode.Z then toggleSummon()
	elseif k == Enum.KeyCode.G then stomp()
	elseif k == Enum.KeyCode.F then fireHeld = true
	elseif k == Enum.KeyCode.LeftShift then sprint = true end
end))
table.insert(conns, UIS.InputEnded:Connect(function(i)
	if i.KeyCode == Enum.KeyCode.F then fireHeld = false
	elseif i.KeyCode == Enum.KeyCode.LeftShift then sprint = false end
end))
