----------------------------------------------------------------
-- Math helpers
----------------------------------------------------------------
local function lerp(a, b, t) return a + (b - a) * t end

local function smooth(x)
	x = math.clamp(x, 0, 1)
	return x * x * (3 - 2 * x)
end

-- keyframe track: keys = { {p, value}, ... } (numbers or Vector3), smooth between
local function track(p, keys)
	if p <= keys[1][1] then return keys[1][2] end
	for i = 2, #keys do
		if p <= keys[i][1] then
			local a, b = keys[i - 1], keys[i]
			local k = smooth((p - a[1]) / (b[1] - a[1]))
			if typeof(a[2]) == "Vector3" then return a[2]:Lerp(b[2], k) end
			return a[2] + (b[2] - a[2]) * k
		end
	end
	return keys[#keys][2]
end

-- forward speed (studs/s) that moves the body D studs between p=a0 and p=b0
local function moveProfile(p, a0, b0, D, dur)
	if p <= a0 or p >= b0 then return 0 end
	local x = (p - a0) / (b0 - a0)
	return D * 6 * x * (1 - x) / ((b0 - a0) * dur)
end

-- two-bone IK: elbow/knee position (both bones have length L)
local function ik(s, w, pole, L)
	local d = w - s
	local dist = d.Magnitude
	if dist < 1e-3 then return s end
	local dir = d / dist
	local mid = (s + w) / 2
	local h = 0
	if dist < 2 * L then h = math.sqrt(L * L - (dist / 2) ^ 2) end
	local perp = pole - dir * pole:Dot(dir)
	if perp.Magnitude < 1e-3 then return mid end
	return mid + perp.Unit * h
end

local function clampReach(sh, target, maxLen)
	local d = target - sh
	local m = d.Magnitude
	if m > maxLen then return sh + d / m * maxLen end
	return target
end

----------------------------------------------------------------
-- Toys
----------------------------------------------------------------
-- which joint each toy follows (priority order)
local SLOTKEYS = {
	"pelvis", "spineMid", "chest", "neck", "spineLow",
	"shL", "shR", "elbL", "elbR", "handL", "handR",
	"kneeL", "kneeR", "ankL", "ankR", "toeL", "toeR",
	"swordHilt", "swordMid", "swordTip",
}

local function getToyFolder()
	return workspace:FindFirstChild(lp.Name .. "SpawnedInToys")
		or workspace:FindFirstChild("Ketik_Ketikketik4SpawnedInToys")
end

local function getToyParts()
	local parts = {}
	local folder = getToyFolder()
	if not folder then return parts end
	for _, toy in ipairs(folder:GetChildren()) do
		local sp = toy:FindFirstChild("SoundPart")
		if sp and sp:IsA("BasePart") then
			table.insert(parts, sp)
			if #parts >= MAX_TOYS then break end
		end
	end
	return parts
end

local function claim(part)
	-- The remote name/arguments may change when the game updates.
	return pcall(function()
		RS.GrabEvents.SetNetworkOwner:FireServer(part, part.CFrame)
	end)
end

local function ownsPart(part)
	if isnetworkowner then
		local ok, r = pcall(isnetworkowner, part)
		if ok then return r end
	end
	return false
end

local function makeMovers(c)
	local part = c.part
	if not (c.bp and c.bp.Parent == part) then
		local bp = Instance.new("BodyPosition")
		bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bp.P = 25000
		bp.D = 1200
		bp.Position = part.Position
		bp.Parent = part
		c.bp = bp
	end
	if not (c.bg and c.bg.Parent == part) then
		local bg = Instance.new("BodyGyro")
		bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		bg.P = 25000
		bg.CFrame = part.CFrame
		bg.Parent = part
		c.bg = bg
	end
end

local function addToy(part, si)
	local c = { part = part, si = si, oldCollide = part.CanCollide }
	part.CanCollide = false
	makeMovers(c)
	table.insert(claimed, c)
	claimedSet[part] = c
	return c
end

local function refill()
	for i = #claimed, 1, -1 do
		local c = claimed[i]
		if not c.part.Parent then
			claimedSet[c.part] = nil
			table.remove(claimed, i)
		end
	end
	if #claimed >= #SLOTKEYS then return end
	local used = {}
	for _, c in ipairs(claimed) do used[c.si] = true end
	for _, part in ipairs(getToyParts()) do
		if not claimedSet[part] then
			local si
			for i = 1, #SLOTKEYS do
				if not used[i] then si = i break end
			end
			if not si then break end
			if claim(part) then
				used[si] = true
				addToy(part, si)
			end
		end
	end
end

----------------------------------------------------------------
-- SKIN: detailed stickman (client-side parts, only you see them)
----------------------------------------------------------------
local BODY_COLOR = Color3.fromRGB(18, 18, 22)

local function mk(parent, shape, size, cf, color, material, transparency)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	if shape then p.Shape = shape end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.Transparency = transparency or 0
	p.Parent = parent
	return p
end

local function newModel(parent, name)
	local m = Instance.new("Model")
	m.Name = name
	local root = mk(m, nil, V(0.2, 0.2, 0.2), CFrame.new(), Color3.new(), Enum.Material.SmoothPlastic, 1)
	m.PrimaryPart = root
	m.Parent = parent
	return m
end

local function limb(parent)
	return mk(parent, Enum.PartType.Cylinder, V(1, 1, 1), CFrame.new(), BODY_COLOR, Enum.Material.SmoothPlastic)
end

local function ball(parent)
	return mk(parent, Enum.PartType.Ball, V(1, 1, 1), CFrame.new(), BODY_COLOR, Enum.Material.SmoothPlastic)
end

-- a cylinder stretched between two points
local function placeCyl(part, a, b, dia)
	local d = b - a
	local len = d.Magnitude
	if len < 1e-3 then
		part.Size = V(0.05, dia, dia)
		part.CFrame = CFrame.new(a)
		return
	end
	local dir = d / len
	local up = math.abs(dir.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	part.Size = V(len, dia, dia)
	part.CFrame = CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0)
end

local function setBall(part, p, d)
	part.Size = V(d, d, d)
	part.CFrame = CFrame.new(p)
end

local function newTrail(part, p0, p1, color, life)
	local a0 = Instance.new("Attachment")
	a0.Position = p0
	a0.Parent = part
	local a1 = Instance.new("Attachment")
	a1.Position = p1
	a1.Parent = part
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = life or 0.3
	tr.Color = ColorSequence.new(color)
	tr.Transparency = NumberSequence.new(0.1, 1)
	tr.LightEmission = 1
	tr.FaceCamera = true
	tr.Enabled = false
	tr.Parent = part
	return tr
end

local function buildSword(parent, sz)
	local m = newModel(parent, "Sword")
	-- the grip is the origin; the blade points to -Z
	mk(m, Enum.PartType.Cylinder, V(0.9 * sz, 0.17 * sz, 0.17 * sz),
		CFrame.new(0, 0, 0.45 * sz) * CFrame.Angles(0, math.pi / 2, 0),
		Color3.fromRGB(95, 60, 35), Enum.Material.SmoothPlastic)
	mk(m, Enum.PartType.Ball, V(0.3, 0.3, 0.3) * sz, CFrame.new(0, 0, 0.95 * sz),
		Color3.fromRGB(215, 175, 70), Enum.Material.Metal)
	mk(m, nil, V(1.1, 0.14, 0.22) * sz, CFrame.new(0, 0, -0.05 * sz),
		Color3.fromRGB(215, 175, 70), Enum.Material.Metal)
	local blade = mk(m, nil, V(0.42, 0.09, 4.2) * sz, CFrame.new(0, 0, -2.15 * sz),
		Color3.fromRGB(215, 225, 240), Enum.Material.Metal)
	mk(m, nil, V(0.14, 0.12, 4.0) * sz, CFrame.new(0, 0, -2.15 * sz),
		Color3.fromRGB(120, 230, 255), Enum.Material.Neon, 0.2)
	local trail = newTrail(blade, V(0, 0, 1.8 * sz), V(0, 0, -2.1 * sz), Color3.fromRGB(150, 235, 255), 0.35)
	return { model = m, trail = trail }
end

local function destroySkin()
	if skin then
		skin.model:Destroy()
		skin = nil
	end
	for _, f in ipairs(fxList) do
		if f.part then f.part:Destroy() end
	end
	fxList = {}
end

local function buildSkin()
	destroySkin()
	local sz = S.size
	local model = Instance.new("Model")
	model.Name = "StickmanSkin"
	skin = { model = model }

	skin.torso = limb(model)
	skin.pelvisB = ball(model)
	skin.neckB = ball(model)
	skin.shBar = limb(model)
	skin.hipBar = limb(model)
	for _, side in ipairs({ "L", "R" }) do
		local arm = {
			up = limb(model), fore = limb(model),
			sh = ball(model), el = ball(model), hand = ball(model),
		}
		arm.trail = newTrail(arm.hand, V(0, 0.45 * sz, 0), V(0, -0.45 * sz, 0), Color3.fromRGB(255, 255, 255), 0.3)
		skin["arm" .. side] = arm
		skin["leg" .. side] = {
			up = limb(model), low = limb(model), foot = limb(model),
			hip = ball(model), knee = ball(model), ank = ball(model), toe = ball(model),
		}
	end
	skin.sword = buildSword(model, sz)

	-- white outline: the classic stickman look, visible through walls
	local hl = Instance.new("Highlight")
	hl.Adornee = model
	hl.FillTransparency = 1 -- outline only, so the sword and rings keep their colors
	hl.OutlineColor = Color3.new(1, 1, 1)
	hl.OutlineTransparency = 0.1
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = model

	model.Parent = workspace
end

-- expanding shockwave ring on the ground
local function spawnRing(center, maxR, color, dur)
	if not skin then return end
	local sz = S.size
	local part = mk(skin.model, Enum.PartType.Cylinder, V(0.2 * sz, 1, 1),
		CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Neon, 0.2)
	table.insert(fxList, { part = part, t0 = tick(), dur = dur, maxR = maxR, center = center, startR = 0.5 * sz })
end

local function updateFx()
	local now = tick()
	local sz = S.size
	for i = #fxList, 1, -1 do
		local f = fxList[i]
		local k = (now - f.t0) / f.dur
		if k >= 1 or not f.part.Parent then
			f.part:Destroy()
			table.remove(fxList, i)
		else
			local e = 1 - (1 - k) ^ 2
			local r = lerp(f.startR, f.maxR, e)
			f.part.Size = V(0.2 * sz, 2 * r, 2 * r)
			f.part.CFrame = CFrame.new(f.center) * CFrame.Angles(0, 0, math.pi / 2)
			f.part.Transparency = 0.2 + 0.8 * k
		end
	end
end

local function updateSkin(J, bodyCF, att)
	local sz = S.size
	local function W(p) return bodyCF:PointToWorldSpace(p * sz) end
	local k = skin

	placeCyl(k.torso, W(J.pelvis), W(J.neck), 0.38 * sz)
	setBall(k.pelvisB, W(J.pelvis), 0.62 * sz)
	setBall(k.neckB, W(J.neck), 0.5 * sz)
	placeCyl(k.shBar, W(J.shL), W(J.shR), 0.3 * sz)
	placeCyl(k.hipBar, W(J.hipL), W(J.hipR), 0.32 * sz)

	for _, side in ipairs({ "L", "R" }) do
		local arm, leg = k["arm" .. side], k["leg" .. side]
		local sh, el, hd = W(J["sh" .. side]), W(J["elb" .. side]), W(J["hand" .. side])
		placeCyl(arm.up, sh, el, 0.3 * sz)
		placeCyl(arm.fore, el, hd, 0.28 * sz)
		setBall(arm.sh, sh, 0.44 * sz)
		setBall(arm.el, el, 0.4 * sz)
		setBall(arm.hand, hd, 0.58 * sz)
		arm.trail.Enabled = (att and att.handTrail) or false

		local hp, kn, an, to = W(J["hip" .. side]), W(J["knee" .. side]), W(J["ank" .. side]), W(J["toe" .. side])
		placeCyl(leg.up, hp, kn, 0.36 * sz)
		placeCyl(leg.low, kn, an, 0.33 * sz)
		placeCyl(leg.foot, an, to, 0.30 * sz)
		setBall(leg.hip, hp, 0.46 * sz)
		setBall(leg.knee, kn, 0.42 * sz)
		setBall(leg.ank, an, 0.40 * sz)
		setBall(leg.toe, to, 0.32 * sz)
	end

	-- sword (on the back, or in the hand)
	local hilt = W(J.swordHilt)
	local dirW = bodyCF:VectorToWorldSpace(J.swordDir)
	local upv = math.abs(dirW.Unit.Y) > 0.95 and Vector3.xAxis or Vector3.yAxis
	k.sword.model:PivotTo(CFrame.lookAt(hilt, hilt + dirW, upv))
	k.sword.trail.Enabled = (att and att.trail) or false
end

